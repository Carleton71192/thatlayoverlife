      "jsonld": {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": "https://www.thatlayover.life/faq#webpage",
        "url": "https://www.thatlayover.life/faq",
        "name": "FAQ · That Layover Life",
        "description": "Questions, answered straight. What TLL is, whether it's free, how to publish and keep your byline, affiliate links, EU dog travel, and press trips.",
        "isPartOf": {
          "@id": "https://www.thatlayover.life/#website"
        },
        "publisher": {
          "@id": "https://www.thatlayover.life/#organization"
        },
        "inLanguage": "en",
        "isAccessibleForFree": true,
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is That Layover Life?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A travel magazine written by the people who took the trips: repeat travelers, expats, and anyone who turns a six-hour connection into a story. Stories go live after the editor in Copenhagen reads them, usually within 48 hours. Free to read."
            }
          },
          {
            "@type": "Question",
            "name": "Is it free to read and to contribute?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes to both, and it stays free for travelers. A paid tier may add premium features later, but existing accounts always keep a free option and we never paywall published stories."
            }
          },
          {
            "@type": "Question",
            "name": "Do you use AI?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not to write stories. Every story is written by the person who took the trip. Nancy reads every story and makes every call."
            }
          },
          {
            "@type": "Question",
            "name": "How do I get published, and do I keep my byline?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sign in, click Share your story, and fill the form. You choose your credit per story (named, pen name, or Anonymous Traveler), and you keep your copyright. A human reads every story before it goes live, usually within 48 hours. The rules it has to pass: 300 words or more, your own photo, a place, links that work. The editor can correct it under the Charter and never rewrites your voice."
            }
          },
          {
            "@type": "Question",
            "name": "Can I include my own links and affiliate links?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, labeled. Affiliate and personal links are welcome as long as they're disclosed, never hidden. Press and affiliate status is a profile field, so it surfaces at the top of every piece."
            }
          },
          {
            "@type": "Question",
            "name": "Can I travel with my dog in the EU?",
            "acceptedAnswer": {
              "@type": "Answer",
