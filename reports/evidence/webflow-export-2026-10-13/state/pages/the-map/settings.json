    "key": "code",
    "value": "<!-- tll-mp3-passport-v1 (Map 3.0, rows M4 to M12, built 10 Oct 2026 from reports/profile-map-3.0/2026-10-10-proposed-changes.md). Reads tllStates only, never writes it. A stamp or a Depth button opens the existing footer editor on that country. Styles live in the page footer block tll-mp3-map-v1. Source: src/pages/the-map/v3/. -->\n<section id=\"tll-passport\" class=\"mp3-pp\" aria-labelledby=\"tll-passport-h\">\n<div class=\"mp3-ink\"><div class=\"mp3-in\">\n<div data-mp3-member>\n<p class=\"mp3-eye\">Your passport</p>\n<p class=\"mp3-big\"><span class=\"mp3-n\" data-mp3=\"total\">0</span><span class=\"mp3-of\">/249</span></p>\n<p class=\"mp3-sub\">Countries and territories · <span data-mp3=\"togo\">249</span> to go · <span data-mp3=\"lived\">0</span> lived in · <span data-mp3=\"lay\">0</span> <span data-mp3=\"layw\">layovers</span>, counted apart</p>\n</div>\n<h2 id=\"tll-passport-h\" class=\"mp3-h2\">Stamp it, <em>or list it.</em></h2>\n<p class=\"mp3-lede\" data-mp3-member>The map above stays how you know it. Down here are the same countries as a wall of stamps, or a plain list you can scan.</p>\n<div data-mp3-visitor hidden><p class=\"mp3-lede\">Sign in and your countries show up here as stamps or a list.</p><a class=\"mp3-cta\" href=\"/signup\">Start your own map →</a></div>\n<ul class=\"mp3-tiles\" data-mp3-member aria-label=\"Countries stamped by region\"></ul>\n</div></div>\n<div data-mp3-member>\n<div class=\"mp3-bar\" id=\"mp3-bar\">\n<div class=\"mp3-grp mp3-views\" role=\"group\" aria-label=\"View\"><button type=\"button\" data-v=\"stamps\" aria-pressed=\"true\">Stamps</button><button type=\"button\" data-v=\"list\" aria-pressed=\"false\">List</button></div>\n<div class=\"mp3-find\"><label for=\"mp3-q\">Find a country</label><input id=\"mp3-q\" type=\"search\" placeholder=\"Country or ISO code\" autocomplete=\"off\" spellcheck=\"false\"></div>\n<div class=\"mp3-grp mp3-chips\" role=\"group\" aria-label=\"Region\" data-g=\"reg\"></div>\n<div class=\"mp3-grp mp3-chips mp3-st\" role=\"group\" aria-label=\"Show\" data-g=\"st\"></div>\n<span class=\"mp3-shown\" role=\"status\" aria-live=\"polite\" id=\"mp3-shown\"></span>\n</div>\n<p class=\"mp3-msg\" id=\"mp3-load\" role=\"status\">Unpacking 249 countries and territories…</p>\n<p class=\"mp3-msg\" id=\"mp3-err\" role=\"alert\"></p>\n<p class=\"mp3-msg\" id=\"mp3-none\" role=\"status\" hidden>No country matches that. Check the spelling, <em>or the filters.</em></p>\n<div class=\"mp3-view\" id=\"mp3-view\"></div>\n</div>\n</section>\n<script id=\"tll-mp3-passport-js-v1\">\n(function(){\nif(window.__mp3pp)return;window.__mp3pp=1;\nvar sec=document.getElementById('tll-passport');if(!sec)return;\nvar pub=document.documentElement.classList.contains('tll-map-public');\n[].forEach.call(sec.querySelectorAll('[data-mp3-member]'),function(e){e.hidden=pub;});\n[].forEach.call(sec.querySelectorAll('[data-mp3-visitor]'),function(e){e.hidden=!pub;});\nvar D=\"020ADANDEAndorra|784AEAREAUnited Arab Emirates|004AFAFGAAfghanistan|028AGATGMAntigua and Barbuda|660AIAIAMAnguilla|008ALALBEAlbania|051AMARMAArmenia|024AOAGOFAngola|010AQATANAntarctica|032ARARGMArgentina|016ASASMOAmerican Samoa|040ATAUTEAustria|036AUAUSOAustralia|533AWABWMAruba|248AXALAEÅland Islands|031AZAZEAAzerbaijan|070BABIHEBosnia and Herzegovina|052BBBRBMBarbados|050BDBGDABangladesh|056BEBELEBelgium|854BFBFAFBurkina Faso|100BGBGREBulgaria|048BHBHRABahrain|108BIBDIFBurundi|204BJBENFBenin|652BLBLMMSaint Barthélemy|060BMBMUMBermuda|096BNBRNABrunei|068BOBOLMBolivia|535BQBESMCaribbean Netherlands|076BRBRAMBrazil|044BSBHSMBahamas|064BTBTNABhutan|074BVBVTNBouvet Island|072BWBWAFBotswana|112BYBLREBelarus|084BZBLZMBelize|124CACANMCanada|166CCCCKOCocos (Keeling) Islands|180CDCODFDR Congo|140CFCAFFCentral African Republic|178CGCOGFCongo|756CHCHEESwitzerland|384CICIVFCôte d'Ivoire|184CKCOKOCook Islands|152CLCHLMChile|120CMCMRFCameroon|156CNCHNAChina|170COCOLMColombia|188CRCRIMCosta Rica|192CUCUBMCuba|132CVCPVFCape Verd