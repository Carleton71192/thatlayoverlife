ope',O:'Oceania',N:'Antarctica'};\nvar XT={'901':['','','E','Northern Cyprus'],'902':['','','F','Somaliland']};\nvar AL={'826':'uk britain great britain england scotland wales northern ireland','840':'usa us america','528':'holland','104':'burma','384':'ivory coast','784':'uae emirates','410':'korea','203':'czech republic','748':'swaziland','132':'cabo verde','626':'east timor','807':'macedonia','792':'turkey turkiye','336':'holy see','180':'drc','900':'kosova'};\nvar DW=['Not yet','Layover','Stayed','Lived'],DT=['+ Stamp it','Layover','Stamped ✓','Lived ★'],DC=['is-not','is-lay','is-stay','is-lived'];\nfunction pad(k){return String(k).padStart(3,'0');}\nfunction fold(s){return String(s).normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}\nfunction flag(a){return a&&a.length===2?a.replace(/./g,function(c){return String.fromCodePoint(127397+c.charCodeAt(0));}):'';}\nvar C=[];\nD.split('|').forEach(function(s){C.push(mk(s.slice(0,3),s.slice(3,5),s.slice(5,8),s[8],s.slice(9)));});\nfunction mk(id,a2,a3,r,n){return {id:id,a2:a2,a3:a3,r:r,n:n,f:fold(n),al:AL[id]||''};}\nvar S={v:'stamps',q:'',reg:'all',st:'all'},dep={},tot=0,liv=0,lay=0,lastId=null;\nfunction rec(){try{var s=JSON.parse(localStorage.getItem('tllStates')||'null');return s&&s.v===2&&s.states?s:null;}catch(e){return null;}}\n/* One counting rule, the same as the editor's tllOwnN: the member's own (non-pet) travelers; Lived + Stayed make the total; layovers apart. */\nfunction read(){\n  var d=rec(),hum={},any=0,R={lived:3,visited:2,layover:1};dep={};tot=0;liv=0;lay=0;\n  if(!d)return;\n  (d.travelers||[]).forEach(function(t){if(t&&!t.pet){hum[t.id]=1;any=1;}});\n  Object.keys(d.states).forEach(function(k){var row=d.states[k]||{},b=0;Object.keys(row).forEach(function(id){if(any&&!hum[id])return;b=Math.max(b,R[row[id]]||0);});dep[pad(k)]=b;if(b>=2)tot++;if(b===3)liv++;if(b===1)lay++;});\n}\nfunction list(){var a=C.slice();Object.keys(XT).forEach(function(k){if(dep[k]){var x=XT[k];a.push(mk(k,x[0],x[1],x[2],x[3]));}});return a;}\nfunction d(c){return dep[c.id]||0;}\nfunction hit(c){\n  var q=S.q;if(S.reg!=='all'&&c.r!==S.reg)return false;\n  var b=d(c);if(S.st==='been'&&b<2||S.st==='lay'&&b!==1||S.st==='not'&&b!==0)return false;\n  if(!q)return true;\n  if(q.length<=3&&(fold(c.a2)===q||fold(c.a3)===q))return true;\n  return q.length<=3?(c.f.indexOf(q)===0||(' '+c.al).indexOf(' '+q)>-1):(c.f.indexOf(q)>-1||c.al.indexOf(q)>-1);\n}\nfunction $(s){return sec.querySelector(s);}\nfunction setT(k,v){[].forEach.call(document.querySelectorAll('[data-mp3=\"'+k+'\"]'),function(e){e.textContent=v;});}\nfunction chips(){\n  var r=$('[data-g=reg]'),t=$('[data-g=st]');\n  r.innerHTML=[['all','All regions']].concat(RO.map(function(k){return [k,RN[k]];})).map(function(x){return '<button type=\"button\" data-reg=\"'+x[0]+'\" aria-pressed=\"'+(S.reg===x[0])+'\">'+x[1]+'</button>';}).join('');\n  t.innerHTML=[['all','All'],['been','Been'],['lay','Layover'],['not','Not yet']].map(function(x){return '<button type=\"button\" data-st=\"'+x[0]+'\" aria-pressed=\"'+(S.st===x[0])+'\">'+x[1]+'</button>';}).join('');\n}\nfunction lbl(c){return 'Log or change '+c.n+', '+DW[d(c)].toLowerCase();}\nfunction stamp(c,i){var b=d(c);return '<button type=\"button\" class=\"mp3-stamp '+DC[b]+'\" data-id=\"'+c.id+'\" data-n=\"'+esc(c.n)+'\" aria-label=\"'+esc(lbl(c))+'\" style=\"--r:'+(((i*7)%5)-2)*0.7+'deg\"><span class=\"mp3-flag\" aria-hidden=\"true\">'+flag(c.a2)+'</span><span class=\"mp3-iso\">'+esc(c.a3)+'</span><span class=\"mp3-nm\">'+esc(c.n)+'</span><span class=\"mp3-tag\">'+DT[b]+'</span></button>';}\nfunction render(){\n  try{\n    read();var all=list(),shown=all.filter(hit),v=$('#mp3-view'),h='';\n    setT('total',tot);setT('togo',Math.max(0,249-tot));setT('lived',liv);setT('lay',lay);setT('layw',lay===1?'layover':'layovers');\n    $('.mp3-tiles').innerHTML=RO.map(function(k){var a=all.filter(function(c){return c.r===k;}),n=a.filter(function(c){return d(c)>=2;}).length;return '<li><span class=\"mp3-tn\">'+RN[k]+'</span><span class=\"mp3-tv\"><b>'+n+'</b> / '+a.length+'</span><span class=\"mp3-tb\" aria-hidden=\"true\"><i style=\"width:'+(a.length?n/a.length*100:0).toFixed(1)+'%\"></i></span></li>';}).join('');\n    if(S.v==='stamps'){\n      RO.forEach(function(k){var a=shown.filter(function(c){return c.r===k;});if(!a.length)return;var t=all.filter(function(c){return c.r===k;}),n=t.filter(function(c){return d(c)>=2;}).length;\n        h+='<section class=\"mp3-reg\" aria-labelledby=\"mp3-r-'+k+'\"><div class=\"mp3-rh\"><h3 id=\"mp3-r-'+k+'\">'+RN[k]+'</h3><p class=\"mp3-rn\">'+n+' / '+t.length+' stamped</p><span class=\"mp3-tb\" aria-hidden=\"true\"><i style=\"width:'+(n/t.length*100).toFixed(1)+'%\"></i></span></div><div class=\"mp3-stamps\">'+a.map(stamp).join('')+'</div></section>';});\n    }else if(shown.length){\n      var by={};shown.slice().sort(function(a,b){return a.f.localeCompare(b.f);}).forEach(function(c){var L=c.f.charAt(0).toUpperCase();(by[L]=by[L]||[]).push(c);});\n      h='<table class=\"mp3-table\"><caption>Countries and territories, A to Z, with how deep you went in each</caption><thead><tr><th scope=\"col\">Country</th><th scope=\"col\">Region</th><th scope=\"col\">Depth</th></tr></thead>'+Object.keys(by).map(function(L){return '<tbody><tr class=\"mp3-lt\"><th scope=\"rowgroup\" colspan=\"3\">'+L+'</th></tr>'+by[L].map(function(c){var b=d(c);return '<tr><th scope=\"row\"><span class=\"mp3-flag\" aria-hidden=\"true\">'+flag(c.a2)+'</span>'+esc(c.n)+'</th><td>'+RN[c.r]+'</td><td><button type=\"button\" class=\"mp3-dep '+DC[b]+'\" data-id=\"'+c.id+'\" data-n=\"'+esc(c.n)+'\" aria-label=\"'+esc(lbl(c))+'\">'+DW[b]+'</button></td></tr>';}).join('')+'</tbody>';}).join('')+'</table>';\n    }\n    v.innerHTML=h;$('#mp3-none').hidden=!!shown.length;$('#mp3-load').hidden=true;\n    $('#mp3-shown').textContent=shown.length+' shown';\n    explain();\n  }catch(e){$('#mp3-load').hidden=true;$('#mp3-err').textContent=\"Couldn't load the atlas. Refresh and it usually behaves.\";}\n}\n/* M10: the two typed explainer numbers become the member's own; visitors never see those two cards (hidden in CSS). */\nfunction explain(){\n  var g=document.querySelector('.tll-map-explainer-grid');if(!g)return;\n  var cs=[].filter.call(g.children,function(e){return e.classList.contains('tll-map-explainer-card');});\n  cs.forEach(function(c){var l=c.querySelector('.tll-map-explainer-label');if(l&&!l.querySelector('h2')){var h2=document.createElement('h2');h2.className='mp3-xh';while(l.firstChild)h2.appendChild(l.firstChild);l.appendChild(h2);}});\n  if(!pub&&cs[1]){\n    [[cs[0],tot,'Every country painted rose is a trip that happened.'],[cs[1],Math.max(0,249-tot),'The cream ones. Every one is a conversation at 9am in someone\\'s kitchen that has not happened yet.']].forEach(function(x){var n=x[0].querySelector('.tll-map-explainer-num'),b=x[0].querySelector('.tll-map-explainer-body');if(n){n.textContent=x[1];n.setAttribute('data-mp3-set','1');}if(b)b.textContent=x[2];});\n  }\n  var w=cs[2];if(w&&!w.querySelector('.mp3-src')){var p=document.createElement('p');p.className='mp3-src';p.innerHTML='As of July 2026. Source: <a href=\"https://whc.unesco.org/en/list/\" target=\"_blank\" rel=\"noopener\">UNESCO World Heritage List<span class=\"mp3-sr\"> (opens in a new tab)</span></a>';var bd=w.querySelector('.tll-map-explainer-body');if(bd)bd.parentNode.insertBefore(p,bd.nextSibling);else w.appendChild(p);}\n}\n/* Opening the editor: never a write. Click the country's own shape (the footer opens the editor on it), else open the editor and search. */\nfunction big(){var s=[].slice.call(document.querySelectorAll('svg'));s.sort(function(a,b){return b.querySelectorAll('path').length-a.querySelectorAll('path').length;});return s[0];}\nfunction edBtn(){return [].filter.call(document.querySelectorAll('button'),function(b){return /Log (a country|or edit countries)/.test(b.textContent);})[0];}\nfunction term(n){var w=fold(n).replace(/[^a-z ]/g,' ').split(/\\s+/).filter(function(x){return x.length>2&&!/^(and|the|saint|island|islands|republic|north|south)$/.test(x);});w.sort(function(a,b){return b.length-a.length;});return w[0]||fold(n);}\nfunction openEd(id,n){\n  lastId=id;var m=big(),p=null;\n  if(m)[].some.call(m.querySelectorAll('path'),function(x){var q=x.__data__;if(q&&q.properties&&q.id!=null&&pad(q.id)===id){p=x;return true;}});\n  if(p&&document.getElementById('tllX')===null)p=null;\n  if(p)p.dispatchEvent(new MouseEvent('click',{bubbles:true}));\n  else{var b=edBtn();if(b){b.click();var q=document.getElementById('tllQ');if(q){q.value=term(n);q.dispatchEvent(new Event('input',{bubbles:true}));}}else{location.hash='#edit';}}\n  setTimeout(function(){var q=document.getElementById('tllQ');if(q)q.focus({preventScroll:true});},80);\n}\nfunction back(){if(!lastId)return;var id=lastId;lastId=null;setTimeout(function(){var b=sec.querySelector('[data-id=\"'+id+'\"]');if(b)b.focus({preventScroll:false});},700);}\nsec.addEventListener('click',function(e){\n  var b=e.target.closest('button');if(!b||!sec.contains(b))return;\n  if(b.dataset.v){S.v=b.dataset.v;[].forEach.call(sec.querySelectorAll('[data-v]'),function(x){x.setAttribute('aria-pressed',x===b);});render();}\n  else if(b.dataset.reg){S.reg=b.dataset.reg;chips();render();}\n  else if(b.dataset.st){S.st=b.dataset.st;chips();render();}\n  else if(b.dataset.id){openEd(b.dataset.id,b.dataset.n);}\n});\n$('#mp3-q').addEventListener('input',function(e){S.q=fold(e.target.value.trim());render();});\n/* M11: the editor's close control becomes a real control, and its depth word reads Stayed (the stored value stays \"visited\"). */\nfunction relabel(el){if(!el)return;var w=document.createTreeWalker(el,NodeFilter.SHOW_TEXT),t;while((t=w.nextNode()))if(t.nodeValue==='Visited')t.nodeValue='Stayed';}\nfunction ed(){\n  var x=document.getElementById('tllX');if(!x||x.__mp3)return !!x;x.__mp3=1;\n  x.setAttribute('role','button');x.tabIndex=0;x.setAttribute('aria-label','Close');\n  x.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();x.click();}});\n  x.addEventListener('click',back);var sv=document.getElementById('tllSave');if(sv)sv.addEventListener('click',back);\n  var q=document.getElementById('tllQ');if(q&&!q.getAttribute('aria-label'))q.setAttribute('aria-label','Search countries');\n  ['tllL','tllLegend'].forEach(function(i){var el=document.getElementById(i);if(!el)return;relabel(el);new MutationObserver(function(){relabel(el);}).observe(el,{childList:true,subtree:true});});\n  return true;\n}\nfunction top(){var t=0;[].forEach.call(document.querySelectorAll('body > *, body > * > nav, body > * > header, body > * > div'),function(el){if(el===sec||el.contains(sec))return;var c=getComputedStyle(el);if((c.position==='fixed'||c.position==='sticky')&&el.getBoundingClientRect().top<=1&&el.offsetHeight<140)t=Math.max(t,el.offsetHeight);});sec.style.setProperty('--mp3-top',t+'px');var b=$('#mp3-bar');if(b)sec.style.setProperty('--mp3-bh',b.offsetHeight+'px');}\nfunction go(){\n  var h=document.querySelector('.tll-map-section-inner');if(h&&!h.querySelector('.mp3-maph')){var m=document.createElement('h2');m.className='mp3-maph mp3-sr';m.textContent='The map';h.insertBefore(m,h.firstChild);}\n  if(pub){explain();return;}\n  chips();render();top();addEventListener('resize',top);\n  addEventListener('tll:states',render);addEventListener('storage',function(e){if(e.key==='tllStates')render();});\n  addEventListener('load',function(){render();top();});\n  var n=0,iv=setInterval(function(){if(ed()||++n>100)clearInterval(iv);},300);\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();\n})();\n</script>\n"
