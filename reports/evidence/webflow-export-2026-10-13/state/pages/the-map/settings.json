    "key": "code",
    "value": "<!-- The Map 2.0 on /the-map (cut-over staged 9 Oct 2026). Member mode with logging from the map (data-tll-editor=\"inline\"); the old SVG canvas below is hidden, not removed, and the Log a country panel still works through window.__tllMapApply. Pinned to commit 6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9. -->\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,800;1,800&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/carleton71192/thatlayoverlife@6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9/map-2.0/dist/tll-map-layers.css\">\n<p id=\"tllm-boot\" style=\"margin:0 0 10px;font:600 12px/1.4 'JetBrains Mono',monospace;letter-spacing:1px;color:#6B6660\" aria-live=\"polite\">LOADING THE MAP CODE</p>\n<div id=\"tll-map-layers\" data-tll-version=\"6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9\" data-tll-style=\"https://tiles.openfreemap.org/styles/dark\" data-tll-editor=\"inline\" aria-label=\"The Map: every layer of where we have been\"><noscript><p>The map needs JavaScript.</p></noscript></div>\n<script>(function(){var V='6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9',R='carleton71192/thatlayoverlife',J='https://cdn.jsdelivr.net/gh/'+R+'@'+V+'/map-2.0/',S='https://cdn.statically.io/gh/'+R+'/'+V+'/map-2.0/';var st=document.getElementById('tllm-boot'),root=document.getElementById('tll-map-layers');function say(t){if(st){st.textContent=t;st.style.display=t?'':'none';}}function css(h){var l=document.createElement('link');l.rel='stylesheet';l.href=h;document.head.appendChild(l);}function load(base,alt,label){var s=document.createElement('script');s.src=base+'dist/tll-map-layers.js';s.onload=function(){say('CODE LOADED FROM '+label+', STARTING');var n=0,iv=setInterval(function(){if(root&&root.querySelector('.tllm-bar')){clearInterval(iv);say('');}else if(++n>30){clearInterval(iv);say('CODE LOADED FROM '+label+' BUT THE MAP DID NOT START'+(window.__tllLastErr?': '+window.__tllLastErr:''));}},300);};s.onerror=function(){if(alt){say('JSDELIVR DID NOT ANSWER, TRYING STATICALLY');root.setAttribute('data-tll-data',alt+'data/');root.setAttribute('data-tll-config',alt+'collections.json');css(alt+'dist/tll-map-layers.css');load(alt,null,'STATICALLY');}else say('THE MAP CODE DID NOT LOAD FROM EITHER HOST');};document.head.appendChild(s);}window.addEventListener('error',function(e){if(/tll-map-layers|maplibre|topojson/.test(e.filename||''))say('MAP ERROR: '+e.message);});load(J,S,'JSDELIVR');})();</script>"
