    "key": "code",
    "value": "<!-- My map on /account · Map 2.0 in member mode, logging from the map (data-tll-editor=\"inline\") · pinned to commit 6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9 · staged 8 Oct 2026 · 9 Oct: Edit the full list link to the list editor on /the-map (Lived / Stayed / Layover per traveler, pets included) -->\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,800;1,800&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/carleton71192/thatlayoverlife@6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9/map-2.0/dist/tll-map-layers.css\">\n<div id=\"my-map\" style=\"background:#0A0B14;padding:64px 20px 72px;color:#F7F1E8;font-family:'IBM Plex Sans Condensed',system-ui,sans-serif\"><div style=\"max-width:1180px;margin:0 auto\">\n<div style=\"font:700 12px/1.4 'JetBrains Mono',monospace;letter-spacing:3px;color:#00C9C8;text-transform:uppercase\">· My map ·</div>\n<div style=\"display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin:8px 0 18px\"><h2 style=\"font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:clamp(32px,4.4vw,56px);line-height:.98;letter-spacing:-.03em;margin:0;color:#F7F1E8\">Every country, <em style=\"color:#FF7093\">on your map.</em></h2><div style=\"display:flex;gap:10px;flex-wrap:wrap\"><a href=\"/the-map#edit\" style=\"font:700 11px/1 'JetBrains Mono',monospace;letter-spacing:1px;color:#F7F1E8;border:1px solid rgba(247,241,232,.45);padding:10px 18px;border-radius:2px;text-decoration:none\">EDIT THE FULL LIST →</a><a href=\"#tll-map-layers\" data-tll-map=\"fullscreen\" style=\"font:700 11px/1 'JetBrains Mono',monospace;letter-spacing:1px;color:#06302f;background:#00C9C8;padding:11px 18px;border-radius:2px;text-decoration:none\">OPEN FULL SCREEN →</a></div></div>\n<p style=\"margin:0 0 18px;max-width:60ch;font-size:16px;line-height:1.45;color:#B9C0D0\">Tap a country and mark it Lived, Stayed, or Layover only. Lived and Stayed make your total. Layovers are counted on their own line. For the full list by traveler, pets included, open Edit the full list.</p>\n<div style=\"display:flex;gap:22px;margin:0 0 16px;font:700 10px/1.4 'JetBrains Mono',monospace;letter-spacing:2px;text-transform:uppercase;color:#B9C0D0\"><div><b id=\"tll-map-counter\" style=\"display:block;font:800 32px/1 'Playfair Display',serif;color:#F7F1E8;letter-spacing:-.02em;margin-bottom:4px\"></b>countries logged</div><div><b id=\"tll-map-pct\" style=\"display:block;font:800 32px/1 'Playfair Display',serif;color:#F7F1E8;letter-spacing:-.02em;margin-bottom:4px\"></b>of the list</div></div>\n<p id=\"tllm-boot\" style=\"margin:0 0 10px;font:600 12px/1.4 'JetBrains Mono',monospace;letter-spacing:1px;color:#B9C0D0\" aria-live=\"polite\">LOADING THE MAP CODE</p>\n<div id=\"tll-map-layers\" data-tll-version=\"6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9\" data-tll-style=\"https://tiles.openfreemap.org/styles/dark\" data-tll-editor=\"inline\" aria-label=\"My map: every list of where I have been\"><noscript><p>The map needs JavaScript.</p></noscript></div>\n</div></div>\n<script>(function(){var V='6a1098ab4f3c8d1f0f42a7dcd9bab6e5fbf0e4e9',R='carleton71192/thatlayoverlife',J='https://cdn.jsdelivr.net/gh/'+R+'@'+V+'/map-2.0/',S='https://cdn.statically.io/gh/'+R+'/'+V+'/map-2.0/';var st=document.getElementById('tllm-boot'),root=document.getElementById('tll-map-layers');function say(t){if(st){st.textContent=t;st.style.display=t?'':'none';}}function css(h){var l=document.createElement('link');l.rel='stylesheet';l.href=h;document.head.appendChild(l);}function load(base,alt,label){var s=document.createElement('script');s.src=base+'dist/tll-map-layers.js';s.onload=function(){say('CODE LOADED FROM '+label+', STARTING');var n=0,iv=setInterval(function(){if(root&&root.querySelector('.tllm-bar')){clearInterval(iv);say('');}else if(++n>30){clearInterval(iv);say('CODE LOADED FROM '+label+' BUT THE MAP DID NOT START'+(window.__tllLastErr?': '+window.__tllLastErr:''));}},300);};s.onerror=function(){if(alt){say('JSDELIVR DID NOT ANSWER, TRYING STATICALLY');root.setAttribute('data-tll-data',alt+'data/');root.setAttribute('data-tll-config',alt+'collections.json');css(alt+'dist/tll-map-layers.css');load(alt,null,'STATICALLY');}else say('THE MAP CODE DID NOT LOAD FROM EITHER HOST');};document.head.appendChild(s);}window.addEventListener('error',function(e){if(/tll-map-layers|maplibre|topojson/.test(e.filename||''))say('MAP ERROR: '+e.message);});load(J,S,'JSDELIVR');})();</script>"
