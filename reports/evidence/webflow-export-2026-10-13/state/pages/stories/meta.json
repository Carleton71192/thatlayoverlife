 "headCode": "<link rel=\"canonical\" href=\"https://www.thatlayover.life/stories\">\n<style id=\"tll-lib-search-v2\">\n/* Library search bar. Webflow applies an authored form class to the .w-form WRAPPER and leaves the inner <form>\n   bare, so the wrapper is the pill and the inner form is the row. It also re-adds .w-input / .w-button defaults\n   (block, 100% width, its own grey border), which is what stacked the field above the button. */\n.tllsb-form{display:flex;align-items:center}\n.tllsb-form > form{display:flex;align-items:center;gap:8px;flex:1 1 auto;min-width:0;width:100%;margin:0}\n.tllsb-input{flex:1 1 auto !important;width:auto !important;min-width:0;height:42px;margin:0 !important;padding:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important;outline:0 !important;font-size:16px;color:#1A1A1A;font-family:'IBM Plex Sans Condensed','IBM Plex Sans',system-ui,-apple-system,sans-serif !important}\n.tllsb-input::placeholder{color:#6B6660;opacity:1}\n.tllsb-btn{flex:0 0 auto;height:42px;margin:0 !important;padding:0 24px !important;border:0 !important;font-family:'IBM Plex Sans Condensed','IBM Plex Sans',system-ui,-apple-system,sans-serif !important;transition:background .15s ease}\n.tllsb-btn:hover{background:#05605F}\n.tllsb-label,.tllsb-clear{font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,monospace !important}\n.tllsb-clear:hover{text-decoration:underline}\n.tllsb-input:focus-visible,.tllsb-btn:focus-visible,.tllsb-clear:focus-visible{outline:3px solid #F0507A !important;outline-offset:2px}\n.tllsb-form .w-form-done,.tllsb-form .w-form-fail{display:none !important}\n.tllsb-form.w-form-loading{opacity:1}\n@media(max-width:700px){.tllsb-inner{gap:12px}.tllsb-label{width:100%}.tllsb-form{min-width:0;width:100%;max-width:none;padding-left:16px}.tllsb-btn{padding:0 16px !important}}\n</style>\n<style id=\"tll-lib-filters-mobile-v1\">\n/* 2026-09-29: under 700px the filter bar laid its three columns (lenses, place + sort, Share CTA) side by side, so every\n   chip stacked into a tall tower. Stack the groups instead, and make each chip group one thumb-scrollable row. */\n@media(max-width:700px){\n.tll-library-filters .tll-filters-inner{display:flex !important;flex-direction:column !important;align-items:stretch !important;gap:10px !important;padding-top:12px !important;padding-bottom:12px !important}\n.tll-library-filters [data-tll-chiprow]{display:flex !important;flex-direction:row !important;flex-wrap:nowrap !important;align-items:center !important;gap:8px !important;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:0 -16px;padding:2px 16px 6px;width:auto !important}\n.tll-library-filters [data-tll-chiprow]::-webkit-scrollbar{display:none}\n.tll-library-filters [data-tll-chiprow] > a{flex:0 0 auto !important;white-space:nowrap !important;padding:8px 14px !important;font-size:13px !important;line-height:1.2 !important;border-radius:999px !important;margin:0 !important}\n.tll-library-filters [data-tll-chiprow] > span{display:none !important}\n.tll-library-filters .tll-chip-rows{display:flex !important;flex-direction:column !important;gap:6px !important;width:auto !important}\n.tll-library-filters .tll-chip-row{display:flex !important;flex-direction:row !important;flex-wrap:nowrap !important;align-items:center !important;gap:6px !important;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:0 -16px;padding:0 16px 4px}\n.tll-library-filters .tll-chip-row::-webkit-scrollbar{display:none}\n.tll-library-filters .tll-filter-label{min-width:0 !important;width:auto !important;flex:0 0 auto !important;margin:0 4px 0 0 !important}\n.tll-library-filters .tll-shelf-chip,.tll-library-filters .tll-filter-chip-on{flex:0 0 auto !important;white-space:nowrap !important;padding:7px 12px !important;font-size:10px !important;line-height:1.2 !important;margin:0 !important}\n.tll-library-filters .tll-filter-cta{align-self:flex-start;padding:10px 16px !important;font-size:12px !important;margin:2px 0 0 !important}\n}\n</style>\n<style id=\"tll-flow-v1\">\n/* TLL long-scroll layer v1 (30 Sep 2026): reveal + endless atlas on the library. Additive. Kit v2.1 tokens only. */\n.tll-flow-reveal{opacity:0;transform:translateY(22px);transition:opacity .52s cubic-bezier(.2,.7,.2,1),transform .52s cubic-bezier(.2,.7,.2,1)}\n.tll-flow-reveal.in{opacity:1;transform:none}\n.tll-atlas{background:#FDF9F3;color:#1A1A1A;padding:80px 24px 0}\n.tll-atlas .in{max-width:1180px;margin:0 auto}\n.tll-atlas .e{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:600;color:#067A79}\n.tll-atlas h2{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:clamp(32px,5vw,84px);line-height:1.02;letter-spacing:-.02em;max-width:14ch;margin:10px 0 0;color:#1A1A1A}\n.tll-atlas p{color:#6B6660;max-width:52ch;margin:14px 0 30px}\n.tll-atlas .list{columns:3;column-gap:32px;border-top:1px solid #E0DACE}\n@media(max-width:800px){.tll-atlas .list{columns:1}}\n.tll-atlas .k{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #E0DACE;break-inside:avoid;text-decoration:none;color:#1A1A1A}\n.tll-atlas .k .n{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:20px}\n.tll-atlas .k .s{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:#6B6660;white-space:nowrap}\n.tll-atlas .k.has .n{color:#C8325B}.tll-atlas .k.has .s{color:#067A79}\n.tll-atlas .k:hover .n{text-decoration:underline;text-decoration-color:#00C9C8;text-underline-offset:3px}\n.tll-atlas .more{padding:40px 0 60px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#6B6660}\n@media(prefers-reduced-motion:reduce){.tll-flow-reveal{opacity:1;transform:none;transition:none}}\n</style>\n<style id=\"tll-v9-j12-v1\">\n/* v9 J12 (6 Oct 2026, 2.0 parity for /stories, DRAFT): the Library search becomes the big underlined headline input, and the server-rendered\n   CMS cards become shelf cards (photo, country badge, Playfair title under the photo per v9.1 fix 04, mono pillar line, byline). CSS only:\n   every element, class, input name and data attribute stays; nothing is removed. Fix 06 applied: placeholder at 60% in #6B6A72, typed text full\n   size Ink, 3px to 4px underline on focus in 150ms. Kit v2.1 tokens only. */\n.tllsb-bar{background:#F7F1E8 !important;padding:6vh 0 4vh !important;border:0 !important}\n.tllsb-inner{display:block !important;max-width:1320px !important;margin:0 auto !important;padding:0 6vw !important}\n.tllsb-label{font-family:'JetBrains Mono',monospace !important;font-size:11px !important;letter-spacing:3px !important;font-weight:600 !important;color:#067A79 !important;text-transform:uppercase !important;margin:0 0 12px !important;width:auto !important;cursor:text}\n.tllsb-form{display:block !important;max-width:none !important;padding:0 !important;background:transparent !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;margin:0 !important}\n.tllsb-form > form{display:flex !important;align-items:flex-end !important;gap:18px !important;border-bottom:3px solid #0A0B14 !important;padding:0 0 12px !important;margin:0 !important;transition:box-shadow 150ms cubic-bezier(.23,1,.32,1)}\n.tllsb-form > form:focus-within{box-shadow:inset 0 -1px 0 #0A0B14}\n.tllsb-input{flex:1 1 auto !important;width:auto !important;min-width:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important;outline:0 !important;margin:0 !important;height:auto !important;font-family:'Playfair Display',Georgia,serif !important;font-weight:800 !important;font-size:clamp(26px,4.4vw,72px) !important;line-height:1.1 !important;letter-spacing:-.02em !important;color:#0A0B14 !important;padding:0 !important}\n.tllsb-input::placeholder{font-size:.6em !important;color:#6B6A72 !important;opacity:1 !important;font-weight:800;letter-spacing:-.01em}\n.tllsb-btn{height:auto !important;padding:13px 18px !important;background:#F0507A !important;color:#0A0B14 !important;font-family:'JetBrains Mono',monospace !important;font-size:12px !important;letter-spacing:2px !important;font-weight:700 !important;text-transform:uppercase !important;border-radius:0 !important;margin-bottom:2px !important}\n.tllsb-btn:hover{background:#D63859 !important;color:#F7F1E8 !important}\n.tllsb-clear{display:inline-block;margin-top:12px;font-size:11px !important;letter-spacing:1.5px;color:#6B6660 !important;text-transform:uppercase}\n@media(max-width:700px){.tllsb-form > form{gap:12px !important}.tllsb-btn{padding:12px 14px !important}}\n/* Shelf cards on the Cream page */\n.tll-lib-grid{display:grid !important;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr)) !important;gap:8vh 3vw !important;align-items:start !important}\n.tll-lib-card{display:block !important;background:transparent !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;padding:0 !important;overflow:visible !important;position:relative}\n.tll-lib-card:hover{box-shadow:none !important}\n.tll-lib-img{display:block !important;width:100% !important;aspect-ratio:4/3 !important;height:auto !important;object-fit:cover !important;border-radius:0 !important;background:#0A0B14}\n.tll-lib-grid > :nth-child(odd) .tll-lib-img{transform:rotate(-.8deg)}\n.tll-lib-grid > :nth-child(even) .tll-lib-img{transform:rotate(.9deg)}\n.tll-lib-body{padding:20px 0 0 !important}\n.tll-lib-meta{position:absolute;left:14px;top:12px;z-index:2;font-family:'JetBrains Mono',monospace !important;font-size:10px !important;letter-spacing:2px !important;color:#F7F1E8 !important;background:#0A0B14 !important;padding:5px 9px !important;text-transform:uppercase !important;margin:0 !important;max-width:calc(100% - 28px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.tll-lib-title{font-family:'Playfair Display',Georgia,serif !important;font-weight:800 !important;font-size:clamp(22px,2vw,32px) !important;line-height:1.06 !important;letter-spacing:-.01em !important;color:#0A0B14 !important;margin:0 !important;text-wrap:balance;overflow-wrap:anywhere}\n.tll-lib-card:hover .tll-lib-title{text-decoration:underline;text-decoration-color:#F0507A;text-decoration-thickness:3px;text-underline-offset:4px}\n.tll-lib-lede{font-family:'IBM Plex Sans Condensed',sans-serif !important;font-size:15px !important;line-height:1.5 !important;color:#3a3a3a !important;margin:8px 0 0 !important;max-width:46ch}\n.tll-lib-byline{display:flex !important;align-items:center !important;gap:8px !important;margin:10px 0 0 !important}\n.tll-lib-byline-img{width:24px !important;height:24px !important;border-radius:50% !important;object-fit:cover !important;box-shadow:0 0 0 1.5px #F0507A}\n.tll-lib-byline-name{font-family:'IBM Plex Sans Condensed',sans-serif !important;font-size:13px !important;font-weight:600 !important;color:#0A0B14 !important;text-decoration:underline;text-decoration-color:#067A79;text-underline-offset:3px}\n.tll-lib-read{font-family:'JetBrains Mono',monospace !important;font-size:10.5px !important;letter-spacing:1.5px !important;color:#6B6660 !important;text-transform:uppercase !important;margin:10px 0 0 !important}\n@media(prefers-reduced-motion:reduce){.tll-lib-grid > * .tll-lib-img{transform:none !important}}\n</style>",
 "footerCode": "<script>\n/* TLL story card links v2 (2026-09-21): each CMS card carries its story slug in its id; point the card at /stories/{slug} and drop the false current-page state. */\n(function(){\n  function fix(){[].slice.call(document.querySelectorAll('a.tll-lib-card[id]')).forEach(function(a){if(!/\\/stories\\/./.test(a.getAttribute('href')||'')){a.setAttribute('href','/stories/'+a.id);a.removeAttribute('aria-current');a.classList.remove('w--current');}});}\n  if(document.readyState!=='loading')fix();else document.addEventListener('DOMContentLoaded',fix);\n})();\n</script>\n<style>\n/* TLL Stories Index v4 (2026-07-29): server-rendered cards replace the v3 JS grid (design s39 STEP 1). Do NOT re-add a client-side card builder; it duplicates the crawlable cards. */\n.tll-library-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:28px;align-items:start}\n.tll-library-grid a[data-tll-card]{transition:box-shadow .2s ease, transform .2s ease}\n.tll-library-grid a[data-tll-card]:hover{box-shadow:0 12px 30px rgba(13,15,26,.12);transform:translateY(-3px)}\n.tll-library-grid a[data-tll-card] h3{font-family:'Syne','Playfair Display',serif;font-weight:800;line-height:1.25}\n.tll-library-grid a[data-tll-card] span{display:block;font-family:'JetBrains Mono',monospace}\n@media(max-width:600px){.tll-library-grid{grid-template-columns:1fr}}\n</style>\n<script id=\"tll-lib-search-v4\">\n/* TLL library search v4 (9 Oct 2026, fix-first item 3). v3 hid cards with an inline style and the chips script, which sorts on load,\n   wrote display back over it, so every card stayed visible under \"1 story matching\". v4 marks misses with data-tll-q-miss, which CSS hides\n   with !important, so the sort cannot undo it. Matching covers the visible text and the hidden country, region and author blocks.\n   No count line: the cards are the answer. A short note shows only when nothing matches. */\n(function(){\n  var q=new URLSearchParams(location.search).get('q'); if(!q) return; q=q.trim(); if(!q) return;\n  var words=q.toLowerCase().split(/\\s+/).filter(Boolean);\n  function norm(s){return String(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();}\n  function run(){\n    var cards=[].slice.call(document.querySelectorAll('[data-tll-card]')); if(!cards.length) return;\n    var hits=0;\n    cards.forEach(function(c){\n      var item=c.closest('.tll-lib-grid > *')||c, t=norm(c.textContent);\n      var hit=words.every(function(w){return t.indexOf(norm(w))>-1;});\n      if(hit){item.removeAttribute('data-tll-q-miss');hits++;} else item.setAttribute('data-tll-q-miss','1');\n    });\n    var grid=document.querySelector('.tll-lib-grid'); if(!grid) return;\n    var old=document.getElementById('tll-q-note'); if(old) old.remove();\n    if(!hits){\n      cards.forEach(function(c){(c.closest('.tll-lib-grid > *')||c).removeAttribute('data-tll-q-miss');});\n      var n=document.createElement('p'); n.id='tll-q-note'; n.setAttribute('role','status');\n      n.innerHTML='Nothing filed for “<span></span>” yet, so here are all the stories. <a href=\"/stories\">Clear the search</a>';\n      n.querySelector('span').textContent=q; grid.parentNode.insertBefore(n,grid);\n    }\n    document.dispatchEvent(new CustomEvent('tll:lib-filtered'));\n  }\n  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else run();\n})();\n</script>\n<script>\n/* TLL library search UI v2 (2026-09-23): the filter bar now carries a visible search field driving the same ?q=\n   the script above reads, so the no-JS page is still the whole crawlable shelf.\n   Webflow puts every form behind Turnstile bot protection, which leaves the submit button disabled. That is right\n   for the newsletter and submission forms and wrong for a search box, which is a GET navigation and collects\n   nothing. Detach this one form from Turnstile and keep its button enabled, then handle submit ourselves in the\n   capture phase so Webflow's form handler never sees it. */\n(function(){\n  function boot(){\n    var i = document.getElementById('tll-lib-q');\n    if (!i || i.__tllWired) return;\n    i.__tllWired = 1;\n    var form = i.form, wrap = form && form.closest('.w-form'), clear = document.getElementById('tll-lib-clear');\n    var q = new URLSearchParams(location.search).get('q') || '';\n    if (q.trim()) { i.value = q; if (clear) clear.style.display = 'inline'; }\n\n    if (form) {\n      form.removeAttribute('data-turnstile-sitekey');\n      if (wrap) wrap.classList.remove('w-form-loading');\n      var btn = form.querySelector('input[type=submit],button[type=submit]');\n      if (btn) {\n        var enable = function(){\n          if (btn.disabled) btn.disabled = false;\n          if (btn.classList.contains('w-form-loading')) btn.classList.remove('w-form-loading');\n          if (wrap && wrap.classList.contains('w-form-loading')) wrap.classList.remove('w-form-loading');\n        };\n        enable();\n        try { new MutationObserver(enable).observe(btn, { attributes: true, attributeFilter: ['disabled','class'] }); } catch (e) {}\n      }\n      document.addEventListener('submit', function(e){\n        if (e.target !== form) return;\n        e.preventDefault(); e.stopPropagation(); submit();\n      }, true);\n    }\n\n    function submit(){\n      var v = (i.value || '').trim();\n      location.href = '/stories' + (v ? '?q=' + encodeURIComponent(v) : '');\n    }\n    i.addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); submit(); } });\n  }\n  if (document.readyState !== 'loading') boot(); else document.addEventListener('DOMContentLoaded', boot);\n  setTimeout(boot, 1200);\n})();\n</script>\n<script id=\"tll-lib-chips-v1\">\n/* TLL Stories chips v1 (2026-09-28, design screen 02): place filter + sort on the server-rendered [data-tll-card] grid.\n   Reads the hidden per-card data blocks (region, reading time, published date, byline location). No-JS = whole shelf.\n   Chips swap tll-shelf-chip (inactive) and tll-filter-chip-on (active); both are single classes on purpose. */\n(function(){\n  function run(){\n    var grid=document.querySelector('.tll-lib-grid')||document.querySelector('.tll-library-grid');if(!grid||grid.dataset.tllChips)return;grid.dataset.tllChips='1';\n    var items=[].slice.call(grid.children).filter(function(el){return el.hasAttribute('data-tll-card')||el.querySelector('[data-tll-card]');});\n    function d(el,s){var n=el.querySelector('['+s+']');return n?n.textContent.trim():'';}\n    var rows=items.map(function(el,i){return{el:el,i:i,region:d(el,'data-tll-region'),mins:parseFloat(d(el,'data-tll-mins'))||999,date:Date.parse(d(el,'data-tll-date'))||0,country:(d(el,'data-tll-country')||d(el,'data-tll-region')).toLowerCase()};});\n    var place='all',sort='recent';\n    function apply(){\n      var shown=rows.filter(function(r){return place==='all'||r.region===place;});\n      rows.forEach(function(r){r.el.style.display=shown.indexOf(r)>-1?'':'none';});\n      shown.sort(function(a,b){return sort==='az'?a.country.localeCompare(b.country):sort==='time'?a.mins-b.mins:(b.date-a.date)||(a.i-b.i);});\n      shown.forEach(function(r){grid.appendChild(r.el);});\n      var note=document.getElementById('tll-chip-note');\n      if(!shown.length){if(!note){note=document.createElement('div');note.id='tll-chip-note';note.setAttribute('role','status');note.style.cssText='border:2px dashed #c9b89a;border-radius:10px;padding:28px;margin-bottom:20px;text-align:center;background:#fff;font-size:14px;color:#3a3a3a';grid.parentNode.insertBefore(note,grid);}\n        note.innerHTML='<div style=\"font-family:\\'Playfair Display\\',serif;font-weight:800;font-size:18px;margin-bottom:6px;color:#0A0B14\">No stories from '+place+' yet.</div><div style=\"color:#6B6660;margin-bottom:12px\">Be the first.</div><a href=\"/submit\" style=\"display:inline-block;background:#D63859;color:#fff;padding:10px 18px;border-radius:6px;font-weight:700;text-decoration:none\">Share your story →</a>';}\n      else if(note)note.remove();\n    }\n    function wire(attr,set){[].forEach.call(document.querySelectorAll('['+attr+']'),function(c){c.addEventListener('click',function(e){e.preventDefault();set(c.getAttribute(attr));\n      [].forEach.call(document.querySelectorAll('['+attr+']'),function(x){var on=x===c;x.classList.toggle('tll-filter-chip-on',on);x.classList.toggle('tll-shelf-chip',!on);x.setAttribute('aria-pressed',on?'true':'false');});apply();});});}\n    wire('data-tll-place',function(v){place=v;});wire('data-tll-sort',function(v){sort=v;});\n    var old=document.querySelector('[data-tll-chiprow] span');if(old&&/SORT:/.test(old.textContent))old.style.display='none';\n    if(!grid.id)grid.id='tll-shelf-grid';\n    apply(); /* 9 Oct 2026, fix-first item 2: sort newest first on load; before this the order only changed after a chip click. */\n  }\n  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();\n})();\n</script>\n<style id=\"tll-lib-chips-css-v1\">\n.tll-shelf-chip:focus-visible,.tll-filter-chip-on:focus-visible{outline:3px solid #D63859;outline-offset:2px}\n.tll-shelf-chip:hover{border-color:#0A0B14}\n@media(max-width:820px){.tll-fos-grid{grid-template-columns:1fr}}\n@media(max-width:600px){.tll-filter-label{min-width:100%}}\n</style>\n<style id=\"tll-lib-fixfirst-v1\">\n/* Fix-first item 2 (9 Oct 2026): a story on the first screen. Hero is a strip, the filter band scrolls with the page and keeps only the\n   place chips, the newest visible story becomes the lead card, photos sit straight except the lead. Sources: Nancy's brief and the\n   9 Oct site review, Part 2. */\n[data-tll-q-miss]{display:none !important}\n#tll-q-note{grid-column:1/-1;font-size:15px;line-height:1.5;color:#3a3a3a;margin:0 0 18px}\n#tll-q-note a{color:#0A0B14;text-decoration:underline;text-underline-offset:3px}\nhtml.tllp-stories .tll-library-hero:has(h1){padding-top:22px !important;padding-b