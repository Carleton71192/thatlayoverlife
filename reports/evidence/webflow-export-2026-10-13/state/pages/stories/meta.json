ut(mark,30);}).observe(g,{childList:true,subtree:false,attributes:true,attributeFilter:['style','data-tll-q-miss']});\n    document.addEventListener('tll:lib-filtered',mark); setTimeout(mark,600); }\n  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else run();\n})();\n</script>\n<style id=\"tll-s3-stories-v1\">\n/* TLL Stories 3.0 (10 Oct 2026). Source: TLL Site Prototype 3.0, screen \"stories\", and the approved proposal\n   reports/stories-3.0/2026-10-10-proposed-changes.md (rows 1 to 9, Nancy: \"Go with defaults\", plus her open-point answers).\n   Loads after footer v5 fix-first and only restyles. Every element, id, data-* attribute, form name, input name and CMS\n   binding stays. New hooks are attributes only: [data-s3-kicker] [data-s3-pillar] [data-s3-mins] [data-s3-place]\n   [data-tll-disclosure], plus .s3-* nodes made by tll-s3-stories-js-v1. Tokens from tll-system.css v1.\n   Overrides tll-v9-j12-v1 and tll-flow-v1 where they clash; both stay until Nancy retires them. */\nhtml.tllp-stories{--s3-ink:#0A0B14;--s3-cream:#F7F1E8;--s3-paper:#FDF9F3;--s3-line:#E0DACE;--s3-line2:#C9C3B8;--s3-text2:#3a3a3a;--s3-muted:#6B6660;--s3-teal-d:#067A79;--s3-rose:#F0507A;--s3-rose-t:#C8325B;--s3-rose-b:#D63859;--s3-amber:#D98A2B;--s3-head:'Playfair Display',Georgia,serif;--s3-body:'IBM Plex Sans Condensed','IBM Plex Sans',system-ui,sans-serif;--s3-mono:'JetBrains Mono',ui-monospace,monospace;--s3-ease:cubic-bezier(.23,1,.32,1)}\n\n/* Row 1. Hero: eyebrow in teal, Playfair 800 title with the rose italic accent. Prototype size only from 900px;\n   phones keep the fix-first strip size so the first story stays on the first screen (open point 2). */\nhtml.tllp-stories .tll-library-hero .tll-eyebrow-rose{font-family:var(--s3-mono) !important;font-size:11px !important;font-weight:600 !important;letter-spacing:3px !important;text-transform:uppercase !important;color:var(--s3-teal-d) !important;background:none !important;padding:0 !important