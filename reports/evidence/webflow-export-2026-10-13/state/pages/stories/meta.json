-stories #tll-q-note a.s3-q-share{display:inline-flex;align-items:center;min-height:44px;padding:0 20px;background:var(--s3-rose-b);color:#fff !important;text-decoration:none !important;transition:background-color 150ms ease-out,transform 100ms var(--s3-ease)}\nhtml.tllp-stories #tll-q-note a.s3-q-share:active{transform:scale(.97)}\n@media(hover:hover){html.tllp-stories #tll-q-note a.s3-q-share:hover{background:#B82C4B}}\nhtml.tllp-stories #tll-q-note a.s3-q-clear{display:inline-flex;align-items:center;min-height:44px;color:var(--s3-ink) !important;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}\nhtml.tllp-stories #tll-q-note a:focus-visible{outline:3px solid var(--s3-ink);outline-offset:3px}\n\n/* Row 4. Place row: mono label, pill chips, 44px targets, 150ms color, press scale. Row 5 (pillar, sort) and\n   row 6 (front of the shelf) stay hidden in the Designer; nothing here shows them. */\nhtml.tllp-stories .tll-library-filters .tll-filter-label{font-family:var(--s3-mono) !important;font-size:10.5px !important;font-weight:600 !important;letter-spacing:1.5px !important;text-transform:uppercase !important;color:var(--s3-muted) !important;min-width:64px}\nhtml.tllp-stories .tll-library-filters .tll-shelf-chip,html.tllp-stories .tll-library-filters .tll-filter-chip-on{font-family:var(--s3-body) !important;font-size:13px !important;letter-spacing:0 !important;text-transform:none !important;border-radius:999px !important;border:1px solid var(--s3-line2) !important;background:transparent !important;color:var(--s3-text2) !important;text-decoration:none !important;cursor:pointer;transition:background-color 150ms ease-out,color 150ms ease-out,border-color 150ms ease-out,transform 100ms var(--s3-ease)}\nhtml.tllp-stories .tll-library-filters .tll-filter-chip-on{background:var(--s3-ink) !important;border-color:var(--s3-ink) !important;color:var(--s3-cream) !important;font-weight:600 !important}\nhtml.tllp-stories .tll-library-filters .tll-shelf-chip:active,html.tllp-stories .tll-library-filters .tll-filter-chip-on:active{transform:scale(.97)}\nhtml.tllp-stories .tll-library-filters .tll-shelf-chip:focus-visible,html.tllp-stories .tll-library-filters .tll-filter-chip-on:focus-visible{outline:3px solid var(--s3-ink) !important;outline-offset:2px}\n@media(hover:hover){html.tllp-stories .tll-library-filters .tll-shelf-chip:hover{border-color:var(--s3-ink) !important;color:var(--s3-ink) !important}}\n@media(hover:none){html.tllp-stories .tll-library-filters .tll-shelf-chip:hover{border-color:var(--s3-line2) !important}}\n\n/* Row 7. Story cards: 4:3 photo with the ink badge (Byline location), title on a cream tab over the photo,\n   SPONSORED chip only for \"Hosted:\" disclosures, mono pillar and minutes, excerpt, byline with the card's own\n   contributor photo. The lead card (9 Oct) keeps its own layout; the 1px ink hairline hover stays as fix-first set it. */\nhtml.tllp-stories .tll-lib-grid{grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr)) !important;gap:8vh 3vw !important}\nhtml.tllp-stories .tll-lib-grid > :not([data-tll-lead]) .tll-lib-body{padding-top:0 !important}\nhtml.tllp-stories .tll-lib-grid > :not([data-tll-lead]) .tll-lib-card .tll-lib-title{position:relative;z-index:1;margin:-30px 0 0 -10px !important;padding:12px 16px 8px !important;max-width:92%;background:var(--s3-cream)}\nhtml.tllp-stories .tll-lib-card .s3-sponsored{display:block;width:fit-content;max-width:100%;margin:10px 0 0;padding:3px 8px;background:var(--s3-amber);color:var(--s3-ink);font-family:var(--s3-mono);font-size:10.5px;font-weight:700;letter-spacing:1px;line-height:1.4;text-transform:uppercase}\nhtml.tllp-stories .tll-lib-card [data-s3-kicker]{display:block;margin:8px 0 0;font-family:var(--s3-mono);font-size:10px;font-weight:600;letter-spacing:1.5px;line-height:1.4;text-transform:uppercase;color:var(--s3-muted)}\nhtml.tllp-stories .tll-lib-grid > [data-tll-lead] .tll-lib-card [data-s3-kicker]{margin:0 0 1