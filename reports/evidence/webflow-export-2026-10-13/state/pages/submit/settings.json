   {
    "key": "code",
    "value": "<fieldset class=\"tll-pen-fieldset\" data-tll-step=\"3\" data-tll-lounge>\n<h3 class=\"tll-pen-legend\">The Layover Lounge</h3>\n<p class=\"tll-pen-help\">Got one photo you love more than the rest? Send it to the Lounge too, where readers browse photos by place.</p>\n<label class=\"tll-pen-checkbox\"><input type=\"checkbox\" name=\"lounge-photo\" value=\"yes\" data-tll-lounge-on><span>Also submit my favorite photo to the Lounge</span></label>\n<div data-tll-lounge-more hidden>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Which photo?</span><select class=\"tll-pen-input\" name=\"lounge-photo-pick\"><option>My hero photo</option><option>One of my gallery photos</option></select><span class=\"tll-pen-helptext\">For a gallery photo, say which one in the caption, for example \"the third one\".</span></label>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Where was it taken?</span><input class=\"tll-pen-input\" type=\"text\" name=\"lounge-photo-place\" maxlength=\"120\" placeholder=\"City, country\"></label>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Caption</span><input class=\"tll-pen-input\" type=\"text\" name=\"lounge-caption\" maxlength=\"200\"><span class=\"tll-pen-helptext\">Same rights as your other photos: yours to share, and fine to show in the Lounge with your name.</span></label>\n</div>\n</fieldset>\n<style id=\"tll-story-extras-v1\">\n.tll-persp-note{background:#E8F4F3;border-left:3px solid #067A79;padding:10px 14px;border-radius:8px;font-size:14px;line-height:1.5;color:#0A0B14;margin:0 0 14px}\n.tll-persp-invite{margin:4px 0 0}\n.tll-persp-row{display:flex;gap:8px;align-items:stretch;margin:6px 0}\n.tll-persp-row input{flex:1;min-width:0;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:13px}\n.tll-persp-copy,.tll-shout-add{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;letter-spacing:1.5px;font-weight:600;text-transform:uppercase;border-radius:999px;padding:0 18px;min-height:44px;cursor:pointer;background:transparent;color:#0A0B14;border:1px solid #0A0B14;transition:background .15s ease,color .15s ease,transform .1s ease}\n.tll-persp-copy:hover,.tll-shout-add:hover{background:#0A0B14;color:#F7F1E8}\n.tll-persp-copy:active,.tll-shout-add:active{transform:scale(.97)}\n.tll-persp-copy:focus-visible,.tll-shout-add:focus-visible{outline:2px solid #067A79;outline-offset:2px}\n.tll-shout-row{border-top:1px solid #EDE6DA;padding:16px 0 4px;margin-top:8px}\n.tll-shout-n{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#067A79;font-weight:600;margin:0 0 8px}\n.tll-shout-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n@media(max-width:560px){.tll-shout-2{grid-template-columns:1fr}}\n.tll-shout-add{margin:10px 0 6px;min-height:40px}\n.tll-shout-why{display:block;margin-top:10px}\n[data-tll-step] [hidden]{display:none !important}\n.tll-invite-done{margin-top:12px;padding-top:12px;border-top:1px solid rgba(10,11,20,.12);font-size:14px;line-height:1.5}\n.tll-invite-done code{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12.5px;word-break:break-all;background:transparent}\n@media(prefers-reduced-motion:reduce){.tll-persp-copy,.tll-shout-add{transition:none}.tll-persp-copy:active,.tll-shout-add:active{transform:none}}\n</style>\n<script id=\"tll-story-extras-js-v1\">\n/* Story form extras v1 (10 Oct 2026, Nancy: other perspectives, pet notes, shout-outs, Lounge photo). Adds fields only; every existing input name is unchanged. */\n(function(){\nfunction $(s,r){return (r||document).querySelector(s);}\nfunction init(){\nvar f=$('form[data-tll-form=\"submit-story\"]');if(!f||f.__tllExtras)return;f.__tllExtras=1;\nvar q=new URLSearchParams(location.search),ORIGIN='https://www.thatlayover.life';\n/* Trip code: from ?trip=, else from the saved draft, else new. */\nvar code=$('[data-tll-trip-code]',f),inv=$('[data-tll-invite]',f),note=$('[data-tll-persp-note]',f),same=f.querySelector('[name=\"same-trip-as\"]');\nvar c=(q.get('trip')||'').replace(/[^A-Za-z0-9-]/g,'').slice(0,16);\nif(!c){try{var d=JSON.parse(localStorage.getItem('tllStoryDraft')||'null');if(d&&d['trip-code'])c=String(d['trip-code']).replace(/[^A-Za-z0-9-]/g,'').slice(0,16);}catch(e){}}\nif(!c)c='T'+Math.random().toString(36).slice(2,6).toUpperCase()+Date.now().toString(36).slice(-4).toUpperCase();\nif(code)code.value=c;\nvar w=(q.get('with')||'').toLowerCase().replace(/[^a-z0-9-]/g,'');\nif(w&&same&&!same.value)same.value=ORIGIN+'/stories/'+w;\nif((q.get('trip')||w)&&note)note.hidden=false;\nvar link=ORIGIN+'/submit?trip='+encodeURIComponent(c);if(inv)inv.value=link;\nvar cp=$('[data-tll-invite-copy]',f),msg=$('[data-tll-invite-msg]',f);\nif(cp)cp.addEventListener('click',function(){var done=function(){if(msg)msg.textContent='Copied. Paste it into a message to your co-travelers.';};\n  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(link).then(done,function(){inv.select();});else{inv.select();try{document.execCommand('copy');done();}catch(e){}}});\n/* Pet notes show once a pet is tagged. */\nvar pets=f.querySelector('[name=\"pets-along\"]'),pn=$('[data-tll-pet-notes]',f);\n/* Shout-outs and Lounge reveal. */\nvar son=$('[data-tll-shout-on]',f),sl=$('[data-tll-shout-list]',f),add=$('[data-tll-shout-add]',f);\nvar lon=$('[data-tll-lounge-on]',f),lm=$('[data-tll-lounge-more]',f);\nfunction rows(){return [].slice.call(f.querySelectorAll('[data-tll-shout-row]'));}\nfunction sync(){\n  if(pn&&pets){var on=!!pets.value.trim()||!!(pn.querySelector('textarea').value.trim());pn.hidden=!on;}\n  if(son&&sl)sl.hidden=!son.checked;\n  if(lon&&lm)lm.hidden=!lon.checked;\n  rows().forEach(function(r,i){if(i===0)return;var used=[].some.call(r.querySelectorAll('input[type=text],select'),function(x){return x.value;});if(used)r.hidden=false;});\n  if(add)add.hidden=rows().every(function(r){return !r.hidden;});}\nif(add)add.addEventListener('click',function(){var r=rows().filter(function(x){return x.hidden;})[0];if(r){r.hidden=false;var i=r.querySelector('input');if(i)i.focus();}sync();});\nf.addEventListener('input',sync);f.addEventListener('change',sync);\nsync();setTimeout(sync,800);setTimeout(sync,2500);\n/* Links: add https:// when it is missing. On success, show the invite link again. */\nf.addEventListener('submit',function(){\n  [].forEach.call(f.querySelectorAll('[name$=\"-link\"]'),function(u){if(u.value&&!/^https?:\\/\\//i.test(u.value))u.value='https://'+u.value;});\n  var box=f.parentNode&&f.parentNode.querySelector('.w-form-done');if(!box||box.querySelector('.tll-invite-done'))return;\n  var p=document.createElement('p');p.className='tll-invite-done';p.innerHTML='Traveled with someone? Send them this link so they can add their version of the trip: <code></code>';p.querySelector('code').textContent=link;box.appendChild(p);});\n}\nif(document.readyState!=='loading')init();else document.addEventListener('DOMContentLoaded',init);\n})();\n</script>\n"
