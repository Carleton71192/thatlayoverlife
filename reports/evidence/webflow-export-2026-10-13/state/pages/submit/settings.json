   {
    "key": "code",
    "value": "<fieldset class=\"tll-pen-fieldset\" data-tll-step=\"2\" data-tll-persp>\n<h3 class=\"tll-pen-legend\">Other perspectives</h3>\n<p class=\"tll-pen-help\">Traveled with someone? Tag them, then send them the invite link so they can write their version of the same trip. The stories get bundled on the site.</p>\n<p class=\"tll-persp-note\" data-tll-persp-note hidden>You're adding another perspective. Your story will be bundled with the trip it came from.</p>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Who was with you?</span><input class=\"tll-pen-input\" type=\"text\" name=\"co-travelers\" maxlength=\"300\" autocomplete=\"off\" placeholder=\"Names or @handles, separated by commas\"><span class=\"tll-pen-helptext\">Only tag people who are happy to be named on the story.</span></label>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Is a story from this trip already on the site?</span><input class=\"tll-pen-input\" type=\"text\" name=\"same-trip-as\" maxlength=\"300\" autocomplete=\"off\" placeholder=\"Paste the story link\"><span class=\"tll-pen-helptext\">Optional. We bundle your story with that one.</span></label>\n<input type=\"hidden\" name=\"trip-code\" data-tll-trip-code>\n<div class=\"tll-persp-invite\"><span class=\"tll-pen-label\" id=\"tll-invite-l\">Their invite link</span><div class=\"tll-persp-row\"><input class=\"tll-pen-input\" type=\"text\" readonly aria-labelledby=\"tll-invite-l\" data-tll-invite><button type=\"button\" class=\"tll-persp-copy\" data-tll-invite-copy>Copy link</button></div><span class=\"tll-pen-helptext\" aria-live=\"polite\" data-tll-invite-msg>Send this to the people you traveled with. Their story joins the same bundle.</span></div>\n</fieldset>\n"
   },
   {
    "key": "attributes",
    "value": []
   }
  ]
 },
 "76d2ca29-46f8-b442-4b40-3c363f7a8c73": {
