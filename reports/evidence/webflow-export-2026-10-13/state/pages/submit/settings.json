   {
    "key": "code",
    "value": "<fieldset class=\"tll-pen-fieldset\" data-tll-step=\"2\" data-tll-shout>\n<h3 class=\"tll-pen-legend\">Shout-outs</h3>\n<p class=\"tll-pen-help\">Restaurants, stays, tours, the guide who saved the day. Optional, and only the places you would send a friend.</p>\n<label class=\"tll-pen-checkbox\"><input type=\"checkbox\" name=\"shoutouts\" value=\"yes\" data-tll-shout-on><span>Add shout-outs to my story</span></label>\n<div data-tll-shout-list hidden>\n<div class=\"tll-shout-row\" data-tll-shout-row=\"1\">\n<p class=\"tll-shout-n\">Shout-out 1</p>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Name</span><input class=\"tll-pen-input\" type=\"text\" name=\"shout-1-name\" maxlength=\"120\" placeholder=\"The place, the guide, the company\"></label>\n<div class=\"tll-shout-2\">\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Type</span><select class=\"tll-pen-input\" name=\"shout-1-type\"><option value=\"\">Pick one</option><option>Restaurant</option><option>Bar or cafe</option><option>Hotel or stay</option><option>Tour or guide</option><option>Transport</option><option>Shop</option><option>Other</option></select></label>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">City</span><input class=\"tll-pen-input\" type=\"text\" name=\"shout-1-city\" maxlength=\"80\"></label>\n</div>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Link</span><input class=\"tll-pen-input\" type=\"text\" inputmode=\"url\" name=\"shout-1-link\" maxlength=\"400\" placeholder=\"https://\"></label>\n<label class=\"tll-pen-checkbox\"><input type=\"checkbox\" name=\"shout-1-affiliate\" value=\"yes\"><span>This is an affiliate link. I earn if someone books through it.</span></label>\n<label class=\"tll-pen-checkbox\"><input type=\"checkbox\" name=\"shout-1-comped\" value=\"yes\"><span>I got this free or discounted.</span></label>\n</div>\n<div class=\"tll-shout-row\" data-tll-shout-row=\"2\" hidden>\n<p class=\"tll-shout-n\">Shout-out 2</p>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Name</span><input class=\"tll-pen-input\" type=\"text\" name=\"shout-2-name\" maxlength=\"120\" placeholder=\"The place, the guide, the company\"></label>\n<div class=\"tll-shout-2\">\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Type</span><select class=\"tll-pen-input\" name=\"shout-2-type\"><option value=\"\">Pick one</option><option>Restaurant</option><option>Bar or cafe</option><option>Hotel or stay</option><option>Tour or guide</option><option>Transport</option><option>Shop</option><option>Other</option></select></label>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">City</span><input class=\"tll-pen-input\" type=\"text\" name=\"shout-2-city\" maxlength=\"80\"></label>\n</div>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Link</span><input class=\"tll-pen-input\" type=\"text\" inputmode=\"url\" name=\"shout-2-link\" maxlength=\"400\" placeholder=\"https://\"></label>\n<label class=\"tll-pen-checkbox\"><input type=\"checkbox\" name=\"shout-2-affiliate\" value=\"yes\"><span>This is an affiliate link. I earn if someone books through it.</span></label>\n<label class=\"tll-pen-checkbox\"><input type=\"checkbox\" name=\"shout-2-comped\" value=\"yes\"><span>I got this free or discounted.</span></label>\n</div>\n<div class=\"tll-shout-row\" data-tll-shout-row=\"3\" hidden>\n<p class=\"tll-shout-n\">Shout-out 3</p>\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Name</span><input class=\"tll-pen-input\" type=\"text\" name=\"shout-3-name\" maxlength=\"120\" placeholder=\"The place, the guide, the company\"></label>\n<div class=\"tll-shout-2\">\n<label class=\"tll-pen-field\"><span class=\"tll-pen-label\">Type</span><select class=\"tll-pen-input\" name=\"shout-3-type\"><option value=\"\">Pick one</option><option>Restaurant</option><option>Bar or cafe</option><option>Hotel or stay</option><option>Tour or guide</option><option>Transport</optio