    "value": "<div id=\"tll-parks\" class=\"tllpk\">\n<style>\n.tllpk{max-width:1180px;margin:0 auto;padding:8px 0 0}\n.tllpk-eb{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:3px;font-weight:600;color:#067A79;text-transform:uppercase;margin-bottom:10px}\n.tllpk h2{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:clamp(30px,3.6vw,44px);line-height:1.02;color:#0A0B14;margin:0 0 10px}\n.tllpk h2 em{color:#D63859;font-style:italic}\n.tllpk-sub{font-size:15px;color:#6B6660;margin:0 0 22px;max-width:620px}\n.tllpk-bar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;background:#fff;border:1px solid #E0DACE;border-radius:12px;padding:16px 20px;margin-bottom:18px}\n.tllpk-n{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:34px;color:#0A0B14;line-height:1}\n.tllpk-n small{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:2px;color:#6B6660;font-weight:600;margin-left:6px}\n.tllpk-track{flex:1 1 200px;height:8px;background:#F0EAE0;border-radius:8px;overflow:hidden;min-width:160px}\n.tllpk-fill{height:100%;width:0;background:linear-gradient(90deg,#067A79,#00C9C8);transition:width .4s ease}\n.tllpk-q{flex:0 1 260px;border:1px solid #E0DACE;border-radius:8px;padding:10px 12px;font-size:14px;background:#FDF9F3}\n.tllpk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px}\n.tllpk-it{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #E0DACE;border-radius:8px;padding:10px 12px;cursor:pointer;transition:border-color .15s,background .15s;user-select:none}\n.tllpk-it:hover{border-color:#067A79}\n.tllpk-it input{width:18px;height:18px;accent-color:#067A79;flex:none;margin:0}\n.tllpk-it b{font-size:14px;font-weight:600;color:#0A0B14;display:block;line-height:1.2}\n.tllpk-it span{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:1px;color:#6B6660}\n.tllpk-it.on{background:#E8F4F3;border-color:#067A79}\n.tllpk-msg{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1px;color:#6B6660;margin-top:12px;min-height:14px}\n</style>\n<div class=\"tllpk-eb\">The parks lifer · U.S. national parks</div>\n<h2>63 parks. Tick the ones you have <em>walked.</em></h2>\n<p class=\"tllpk-sub\">Every U.S. national park, from Acadia to Zion. Tick a park once you have been, and your count saves to your account.</p>\n<div class=\"tllpk-bar\">\n<div class=\"tllpk-n\"><span id=\"tllpk-count\">0</span><small>OF 63</small></div>\n<div class=\"tllpk-track\" aria-hidden=\"true\"><div class=\"tllpk-fill\" id=\"tllpk-fill\"></div></div>\n<input class=\"tllpk-q\" id=\"tllpk-q\" type=\"search\" placeholder=\"Find a park or a state\" aria-label=\"Filter national parks\">\n</div>\n<div class=\"tllpk-grid\" id=\"tllpk-grid\" role=\"group\" aria-label=\"U.S. national parks visited\"></div>\n<div class=\"tllpk-msg\" id=\"tllpk-msg\" aria-live=\"polite\"></div>\n<script>\n(function(){\nvar P=\"ACAD|Acadia|ME;NPSA|American Samoa|AS;ARCH|Arches|UT;BADL|Badlands|SD;BIBE|Big Bend|TX;BISC|Biscayne|FL;BLCA|Black Canyon of the Gunnison|CO;BRCA|Bryce Canyon|UT;CANY|Canyonlands|UT;CARE|Capitol Reef|UT;CAVE|Carlsbad Caverns|NM;CHIS|Channel Islands|CA;CONG|Congaree|SC;CRLA|Crater Lake|OR;CUVA|Cuyahoga Valley|OH;DEVA|Death Valley|CA, NV;DENA|Denali|AK;DRTO|Dry Tortugas|FL;EVER|Everglades|FL;GAAR|Gates of the Arctic|AK;JEFF|Gateway Arch|MO;GLAC|Glacier|MT;GLBA|Glacier Bay|AK;GRCA|Grand Canyon|AZ;GRTE|Grand Teton|WY;GRBA|Great Basin|NV;GRSA|Great Sand Dunes|CO;GRSM|Great Smoky Mountains|NC, TN;GUMO|Guadalupe Mountains|TX;HALE|Haleakala|HI;HAVO|Hawaii Volcanoes|HI;HOSP|Hot Springs|AR;INDU|Indiana Dunes|IN;ISRO|Isle Royale|MI;JOTR|Joshua Tree|CA;KATM|Katmai|AK;KEFJ|Kenai Fjords|AK;KICA|Kings Canyon|CA;KOVA|Kobuk Valley|AK;LACL|Lake Clark|AK;LAVO|Lassen Volcanic|CA;MACA|Mammoth Cave|KY;MEVE|Mesa Verde|CO;MORA|Mount Rainier|WA;NERI|New River Gorge|WV;NOCA|North Cascades|WA;OLYM|Olympic|WA;PEFO|Petrified Forest|AZ;PINN|Pinnacles|CA;REDW|Redwood|CA;ROMO|Rocky Mountain|CO;SAGU|Saguaro|AZ;SEQU|Sequoia|CA;SHEN|Shenandoah|VA;THRO|Theodore Roosevelt|ND;VIIS|Virgin Islands|VI;VOYA|Voyageurs|MN;WHSA|White Sands|NM;WICA|Wind Cave|SD;WRST|Wrangell-St. Elias|AK;YELL|Yellowstone|WY, MT, ID;YOSE|Yosemite|CA;ZION|Zion|UT\".split(\";\").map(function(r){r=r.split(\"|\");return{c:r[0],n:r[1],s:r[2]};});\nvar KEY=\"tllParks\",state={v:1,parks:{}},grid=document.getElementById(\"tllpk-grid\"),msg=document.getElementById(\"tllpk-msg\");\ntry{var ls=JSON.parse(localStorage.getItem(KEY)||\"null\");if(ls&&ls.parks)state=ls;}catch(e){}\nfunction render(){grid.innerHTML=\"\";P.forEach(function(p){var on=!!state.parks[p.c];var l=document.createElement(\"label\");l.className=\"tllpk-it\"+(on?\" on\":\"\");l.setAttribute(\"data-q\",(p.n+\" \"+p.s).toLowerCase());l.innerHTML='<input type=\"checkbox\" value=\"'+p.c+'\"'+(on?\" checked\":\"\")+'><div><b>'+p.n+'</b><span>'+p.s+'</span></div>';grid.appendChild(l);});count();}\nfunction count(){var n=Object.keys(state.parks).length;document.getElementById(\"tllpk-count\").textContent=n;document.getElementById(\"tllpk-fill\").style.width=Math.round(n/63*100)+\"%\";}\nfunction ms(){return window.$memberstackDom;}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}\nvar m=ms();if(!m){msg.textContent=\"Saved on this device.\";return;}\nm.getMemberJSON().then(function(r){var j=(r&&r.data)||{};j.tllParks=state;return m.updateMemberJSON({json:j});}).then(function(){msg.textContent=\"Saved to your account.\";}).catch(function(){msg.textContent=\"Saved on this device. Account sync will retry.\";});}\ngrid.addEventListener(\"change\",function(e){var i=e.target;if(!i.value)return;if(i.checked)state.parks[i.value]=Date.now();else delete state.parks[i.value];i.closest(\".tllpk-it\").classList.toggle(\"on\",i.checked);count();save();});\ndocument.getElementById(\"tllpk-q\").addEventListener(\"input\",function(){var q=this.value.trim().toLowerCase();[].forEach.call(grid.children,function(el){el.style.display=!q||el.getAttribute(\"data-q\").indexOf(q)>-1?\"\":\"none\";});});\nrender();\nvar n=0,iv=setInterval(function(){var m=ms();if(m){clearInterval(iv);m.getCurrentMember().then(function(r){if(!r||!r.data)return;return m.getMemberJSON().then(function(mj){var d=mj&&mj.data&&mj.data.tllParks;if(d&&d.parks){state=d;try{localStorage.setItem(KEY,JSON.stringify(d));}catch(e){}render();}});}).catch(function(){});}else if(++n>40)clearInterval(iv);},250);\n})();\n</script>\n</div>"
