 "headCode": "<meta name=\"robots\" content=\"noindex, follow\">\n<style id=\"tll-pet-extras-css-v1\">[data-tll-pet-extras] h6{font:inherit;margin:0;color:inherit;letter-spacing:inherit;text-transform:inherit;display:block}[data-tll-pet-extras] .tll-pen-helptext h6{font:inherit}</style>\n<script id=\"tll-pet-extras-v1\">\n/* Pet extras v1 (29 Sep 2026): carries countries and own-account handles from the add-pet form into the member's pet record saved by the pet editor. Adds nothing else; the editor keeps owning the record. */\n(function(){\n  var CODES=\"AD,AE,AF,AG,AL,AM,AO,AR,AT,AU,AZ,BA,BB,BD,BE,BF,BG,BH,BI,BJ,BN,BO,BR,BS,BT,BW,BY,BZ,CA,CD,CF,CG,CH,CI,CL,CM,CN,CO,CR,CU,CV,CY,CZ,DE,DJ,DK,DM,DO,DZ,EC,EE,EG,ER,ES,ET,FI,FJ,FM,FR,GA,GB,GD,GE,GH,GM,GN,GQ,GR,GT,GW,GY,HN,HR,HT,HU,ID,IE,IL,IN,IQ,IR,IS,IT,JM,JO,JP,KE,KG,KH,KI,KM,KN,KP,KR,KW,KZ,LA,LB,LC,LI,LK,LR,LS,LT,LU,LV,LY,MA,MC,MD,ME,MG,MH,MK,ML,MM,MN,MR,MT,MU,MV,MW,MX,MY,MZ,NA,NE,NG,NI,NL,NO,NP,NR,NZ,OM,PA,PE,PG,PH,PK,PL,PS,PT,PW,PY,QA,RO,RS,RU,RW,SA,SB,SC,SD,SE,SG,SI,SK,SL,SM,SN,SO,SR,SS,ST,SV,SY,SZ,TD,TG,TH,TJ,TL,TM,TN,TO,TR,TT,TV,TZ,UA,UG,US,UY,UZ,VA,VC,VE,VN,VU,WS,YE,ZA,ZM,ZW\".split(\",\");\n  function ready(fn){ if(document.readyState!==\"loading\") fn(); else document.addEventListener(\"DOMContentLoaded\",fn); }\n  ready(function(){\n    var f=document.querySelector('form[data-tll-form=\"add-pet\"]'); if(!f) return;\n    var dl=document.createElement(\"datalist\"); dl.id=\"tll-country-list\";\n    try{ var dn=new Intl.DisplayNames([\"en\"],{type:\"region\"}); dl.innerHTML=CODES.map(function(c){return '<option value=\"'+dn.of(c).replace(/\"/g,\"&quot;\")+'\">';}).join(\"\"); }catch(e){}\n    f.appendChild(dl);\n    var extras=null;\n    f.addEventListener(\"submit\",function(){\n      var g=function(n){ var el=f.querySelector('[name=\"'+n+'\"]'); return el?el.value.trim():\"\"; };\n      extras={name:g(\"name\"),countries:g(\"pet-countries\").split(\",\").map(function(s){return s.trim();}).filter(Boolean),instagram:g(\"pet-instagram\").replace(/^@/,\"\"),tiktok:g(\"pet-tiktok\").replace(/^@/,\"\"),strava:g(\"pet-strava\")};\n      if(!extras.name||(!extras.countries.length&&!extras.instagram&&!extras.tiktok&&!extras.strava)){ extras=null; return; }\n      var tries=0, t=setInterval(function(){\n        var ms=window.$memberstackDom; if(!ms||++tries>40){ if(tries>40) clearInterval(t); return; }\n        ms.getMemberJSON().then(function(j){\n          var json=(j&&j.data)||{}, pets=Array.isArray(json.pets)?json.pets:[];\n          var p=null; for(var i=pets.length-1;i>=0;i--){ if(pets[i].name===extras.name&&!pets[i].extrasApplied){ p=pets[i]; break; } }\n          if(!p) return;\n          clearInterval(t);\n          if(extras.countries.length) p.countries=extras.countries;\n          if(extras.instagram) p.instagram=extras.instagram; if(extras.tiktok) p.tiktok=extras.tiktok; if(extras.strava) p.strava=extras.strava;\n          p.extrasApplied=true; json.pets=pets;\n          return ms.updateMemberJSON({json:json});\n        }).catch(function(){});\n      },500);\n    },true);\n  });\n})();\n</script>",
 "footerCode": "<style id=\"tll-pet-editor-css\">\n.tpe-row{background:#0A0B14;border-radius:12px;padding:16px 18px;margin-bottom:14px;display:flex;align-items:center;gap:16px;color:#F7F1E8}\n.tpe-av{width:56px;height:56px;border-radius:50%;flex:none;border:2px solid #00C9C8;background:#16182a center/cover;display:flex;align-items:center;justify-content:center;font-size:26px}\n.tpe-nm{font-family:\"Playfair Display\",Georgia,serif;font-weight:800;font-size:20px;line-height:1.15;margin:0 0 4px;color:#F7F1E8}\n.tpe-meta{font-family:\"JetBrains Mono\",monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#9a9cb3}\n.tpe-acts{display:flex;flex-direction:column;gap:6px;align-items:flex-end;margin-left:auto}\n.tpe-acts button,.tpe-acts a{font-family:\"JetBrains Mono\",monospace;font-size:12px;letter-spacing:1px;background:none;border:0;padding:6px 0;min-height:32px;cursor:pointer;text-decoration:none}\n.tpe-edit{color:#00C9C8;font-weight:600}.tpe-view{color:#9a9cb3}\n.tpe-panel{scroll-margin-top:110px;background:#0A0B14;border:1px solid #00C9C8;border-radius:12px;padding:22px;margin:0 0 22px;color:#F7F1E8}\n.tpe-panel[hidden]{display:none}\n.tpe-ey{font-family:\"JetBrains Mono\",monospace;font-size:11px;letter-spacing:2px;color:#00C9C8;font-weight:600;margin-bottom:16px;text-transform:uppercase}\n.tpe-g{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}\n.tpe-g3{grid-template-columns:1fr 1fr 1fr}\n.tpe-f{margin-bottom:12px}\n.tpe-f label,.tpe-lbl{display:block;font-family:\"JetBrains Mono\",monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#9a9cb3;margin-bottom:6px}\n.tpe-f input,.tpe-f textarea,.tpe-f select{width:100%;background:#16182a;border:1px solid #2b2f52;border-radius:6px;padding:10px 12px;font-size:15px;color:#F7F1E8;font-family:inherit}\n.tpe-f textarea{min-height:84px;resize:vertical}\n.tpe-f input:focus,.tpe-f textarea:focus,.tpe-f select:focus{outline:2px solid #00C9C8;outline-offset:1px}\n.tpe-yn{display:flex;gap:8px}\n.tpe-yn button{font-size:14px;background:#16182a;color:#c9cbe0;border:1px solid #2b2f52;padding:8px 16px;border-radius:6px;cursor:pointer;min-height:40px}\n.tpe-yn button[aria-pressed=\"true\"]{background:#00C9C8;color:#06302f;border-color:#00C9C8;font-weight:700}\n.tpe-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}\n.tpe-chip{font-size:13px;background:#16182a;border:1px solid #2b2f52;border-radius:999px;padding:5px 6px 5px 12px;display:inline-flex;align-items:center;gap:4px}\n.tpe-chip button{background:none;border:0;color:#9a9cb3;cursor:pointer;font-size:16px;line-height:1;min-width:28px;min-height:28px}\n.tpe-addrow{display:flex;gap:8px}.tpe-addrow input{flex:1}\n.tpe-addrow button{background:none;border:1px solid #00C9C8;color:#00C9C8;border-radius:6px;padding:0 14px;cursor:pointer;font-family:\"JetBrains Mono\",monospace;font-size:12px}\n.tpe-btns{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px}\n.tpe-save{background:#00C9C8;color:#06302f;border:0;border-radius:6px;padding:12px 22px;font-weight:700;font-size:15px;cursor:pointer;min-height:44px}\n.tpe-cancel{background:none;border:1px solid #2b2f52;color:#c9cbe0;border-radius:6px;padding:12px 18px;cursor:pointer;min-height:44px}\n.tpe-del{background:none;border:0;color:#F0507A;margin-left:auto;cursor:pointer;font-size:14px;min-height:44px}\n.tpe-msg{font-size:14px;color:#c9cbe0;margin-top:10px}\n.tpe-note{font-size:13px;color:#9a9cb3;margin-top:12px;line-height:1.45}\n@media(max-width:600px){.tpe-g,.tpe-g3{grid-template-columns:1fr}.tpe-row{flex-wrap:wrap}.tpe-acts{flex-direction:row;gap:16px;margin-left:72px}}\n</style>\n<script id=\"tll-pet-editor\">\n/* TLL pet editor v1.1 (2026-09-21). Member pets live in Memberstack member JSON (json.pets).\n   Renders the member's own pets on /my-pets, with an Edit panel per pet. Keeps the add-pet form and its input names;\n   a new submission is also saved to the member's pets. Public /pets/{slug} pages still come from the CMS. */\n(function(){\n  var FOUNDER_SLUG='nancy-carleton';\n  /* Seed for the founder's first load only. Countries and weight are filled from the CMS (Pets: countries-list, weight-kg) via the public passport page. */\n  var MAGNUS={id:'magnus-waffles',cmsSlug:'magnus-waffles',name:'Magnus Waffles',emoji:'🐻‍❄️',species:'Dog',breed:'Samoyed',dob:'2023-07-03',weightKg:null,euPassport:true,\n    countries:[],\n    bio:'Polar bear by appearance, supervisor by profession. Has crossed more EU borders than your accountant.',snack:'Coconut. He drinks the water, then eats the meat.',\n    avatar:'https://cdn.prod.website-files.com/6a0b29c6d081332e921900d8/6a0e02c4823ce7e6fcd3e743_6a0e022486157e60bbf8ce14_Magnus%2520colors.jpeg',instagram:'',tiktok:'',strava:''};\n  function esc(s){var d=document.createElement('div');d.textContent=s==null?'':String(s);return d.innerHTML;}\n  function age(p){if(p.dob){var b=new Date(p.dob),n=new Date(),a=n.getFullYear()-b.getFullYear();if(n<new Date(n.getFullYear(),b.getMonth(),b.getDate()))a--;return a>=0?a:null;}return p.ageYears!=null&&p.ageYears!==''?Number(p.ageYears):null;}\n  function slugify(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');}\n  function meta(p){var a=age(p),bits=[p.breed||p.species];if(a!=null)bits.push(a+(a===1?' yr':' yrs'));if(p.weightKg)bits.push(p.weightKg+' kg');var c=(p.countries||[]).length;bits.push(c+(c===1?' country':' countries'));return bits.filter(Boolean).join(' · ');}\n  var ms,member,json,pets=[],grid,title,panel,editing=null;\n  function save(){json=json||{};json.pets=pets;return ms.updateMemberJSON({json:json});}\n  function heading(){if(!title)return;var em=title.querySelector('em');var n=pets.length;if(em)em.textContent=n+(n===1?' bestie':' besties');}\n  function render(){\n    [].forEach.call(grid.querySelectorAll('.tll-mypets-card:not(.tll-mypets-card-add),.tpe-row'),function(el){el.remove();});\n    var add=grid.querySelector('.tll-mypets-card-add');\n    pets.forEach(function(p,i){\n      var r=document.createElement('article');r.className='tpe-row';\n      var av=p.avatar?'<div class=\"tpe-av\" style=\"background-image:url(\\''+esc(p.avatar).replace(/'/g,'%27')+'\\')\" role=\"img\" aria-label=\"'+esc(p.name)+'\"></div>':'<div class=\"tpe-av\" aria-hidden=\"true\">'+esc(p.emoji||'🐾')+'</div>';\n      var nm=esc(p.name);if(p.emoji&&p.avatar){var parts=nm.split(' ');nm=parts.length>1?parts[0]+' '+esc(p.emoji)+' '+parts.slice(1).join(' '):nm+' '+esc(p.emoji);}\n      r.innerHTML=av+'<div><h3 class=\"tpe-nm\">'+nm+'</h3><div class=\"tpe-meta\">'+esc(meta(p))+(p.euPassport?' · EU passport':'')+'</div></div><div class=\"tpe-acts\"><button type=\"button\" class=\"tpe-edit\" data-i=\"'+i+'\">Edit →</button>'+(p.cmsSlug?'<a class=\"tpe-view\" href=\"/pets/'+esc(p.cmsSlug)+'\">View public</a>':'')+'</div>';\n      grid.insertBefore(r,add||null);\n    });\n    heading();\n  }\n  function field(id,lab,val,type,extra){return '<div class=\"tpe-f\"><label for=\"tpe-'+id+'\">'+lab+'</label><input id=\"tpe-'+id+'\" type=\"'+(type||'text')+'\" value=\"'+esc(val)+'\" '+(extra||'')+'></div>';}\n  function openEdit(i){\n    editing=i;var p=pets[i];var cs=(p.countries||[]).slice();\n    panel.innerHTML='<div class=\"tpe-ey\">Edit · '+esc(p.name)+'</div>'\n      +'<div class=\"tpe-g\">'+field('name','Name',p.name,'text','required maxlength=\"80\"')+field('emoji','Emoji',p.emoji,'text','maxlength=\"12\"')+'</div>'\n      +'<div class=\"tpe-g\">'+field('species','Species',p.species)+field('breed','Breed',p.breed)+'</div>'\n      +'<div class=\"tpe-g\">'+field('dob','Date of birth',p.dob,'date')+field('weight','Weight (kg)',p.weightKg,'number','min=\"0\" max=\"120\" step=\"0.1\"')+'</div>'\n      +'<div class=\"tpe-f\"><span class=\"tpe-lbl\" id=\"tpe-eu-l\">EU pet passport</span><div class=\"tpe-yn\" role=\"group\" aria-labelledby=\"tpe-eu-l\"><button type=\"button\" data-v=\"1\" aria-pressed=\"'+(!!p.euPassport)+'\">Yes</button><button type=\"button\" data-v=\"0\" aria-pressed=\"'+(!p.euPassport)+'\">Not yet</button></div></div>'\n      +'<div class=\"tpe-f\"><label for=\"tpe-cin\">Countries crossed together</label><div class=\"tpe-addrow\"><input id=\"tpe-cin\" placeholder=\"Type a country, press Enter\"><button type=\"button\" id=\"tpe-cadd\">+ Add</button></div><div class=\"tpe-chips\" id=\"tpe-chips\"></div></div>'\n      +'<div class=\"tpe-f\"><label for=\"tpe-bio\">Bio</label><textarea id=\"tpe-bio\" maxlength=\"500\">'+esc(p.bio)+'</textarea></div>'\n      +'<div class=\"tpe-g\">'+field('snack','Favorite snack',p.snack)+field('avatar','Photo URL',p.avatar,'url')+'</div>'\n      +'<span class=\"tpe-lbl\">Social profiles · optional</span><div class=\"tpe-g tpe-g3\">'+field('ig','Instagram @',p.instagram)+field('tt','TikTok @',p.tiktok)+field('st','Strava',p.strava)+'</div>'\n      +'<div class=\"tpe-btns\"><button type=\"button\" class=\"tpe-save\" id=\"tpe-save\">Save changes</button><button type=\"button\" class=\"tpe-cancel\" id=\"tpe-cancel\">Cancel</button><button type=\"button\" class=\"tpe-del\" id=\"tpe-del\">Remove pet</button></div>'\n      +'<div class=\"tpe-msg\" id=\"tpe-msg\" role=\"status\" aria-live=\"polite\"></div>'\n      +(p.cmsSlug?'<p class=\"tpe-note\">Saved to your account right away. The public page at /pets/'+esc(p.cmsSlug)+' updates separately.</p>':'');\n    panel.hidden=false;\n    var eu=!!p.euPassport;[].forEach.call(panel.querySelectorAll('.tpe-yn button'),function(b){b.onclick=function(){eu=b.getAttribute('data-v')==='1';[].forEach.call(panel.querySelectorAll('.tpe-yn button'),function(x){x.setAttribute('aria-pressed',String(x===b));});};});\n    function chips(){var c=document.getElementById('tpe-chips');c.innerHTML=cs.map(function(n,k){return '<span class=\"tpe-chip\">'+esc(n)+'<button type=\"button\" aria-label=\"Remove '+esc(n)+'\" data-k=\"'+k+'\">×</button></span>';}).join('')||'<span class=\"tpe-note\" style=\"margin:0\">None logged yet.</span>';[].forEach.call(c.querySelectorAll('button'),function(b){b.onclick=function(){cs.splice(+b.getAttribute('data-k'),1);chips();};});}\n    function addC(){var inp=document.getElementById('tpe-cin'),v=inp.value.trim();if(v&&cs.map(function(x){return x.toLowerCase();}).indexOf(v.toLowerCase())<0)cs.push(v);inp.value='';chips();inp.focus();}\n    chips();document.getElementById('tpe-cadd').onclick=addC;document.getElementById('tpe-cin').onkeydown=function(e){if(e.key==='Enter'){e.preventDefault();addC();}};\n    function v(id){var el=document.getElementById('tpe-'+id);return el?el.value.trim():'';}\n    var msg=document.getElementById('tpe-msg');\n    document.getElementById('tpe-cancel').onclick=function(){panel.hidden=true;panel.innerHTML='';};\n    var armed=false;document.getElementById('tpe-del').onclick=function(){if(!armed){armed=true;this.textContent='Tap again to remove '+p.name;return;}pets.splice(i,1);msg.textContent='Removing…';save().then(function(){panel.hidden=true;render();}).catch(function(e){msg.textContent='Could not save: '+((e&&e.message)||e);});};\n    document.getElementById('tpe-save').onclick=function(){\n      if(!v('name')){msg.textContent='Your pet needs a name.';return;}\n      var w=v('weight');\n      var np=Object.assign({},p,{name:v('name'),emoji:v('emoji'),species:v('species'),breed:v('breed'),dob:v('dob'),weightKg:w===''?null:Number(w),euPassport:eu,countries:cs,bio:v('bio'),snack:v('snack'),avatar:v('avatar'),instagram:v('ig').replace(/^@/,''),tiktok:v('tt').replace(/^@/,''),strava:v('st'),updated:new Date().toISOString()});\n      pets[i]=np;msg.textContent='Saving…';\n      save().then(function(){msg.textContent='Saved.';render();setTimeout(function(){panel.hidden=true;panel.innerHTML='';},900);}).catch(function(e){msg.textContent='Could not save: '+((e&&e.message)||e);});\n    };\n    panel.scrollIntoView({behavior:'smooth',block:'start'});var f=document.getElementById('tpe-name');if(f)f.focus({preventScroll:true});\n  }\n  function hookAddForm(){\n    var f=document.querySelector('form[data-tll-form=\"add-pet\"]');if(!f||f.dataset.tpe)return;f.dataset.tpe='1';\n    f.addEventListener('submit',function(){\n      var g=function(n){var el=f.querySelector('[name=\"'+n+'\"]');return el?(el.type==='checkbox'?el.checked:el.value.trim()):'';};\n      var name=g('name');if(!name||!ms)return;\n      var p={id:slugify(name)+'-'+Date.now().toString(36),name:name,emoji:'',species:g('species'),breed:g('breed'),ageYears:g('age'),dob:'',weightKg:null,euPassport:!!g('has-eu-passport'),countries:[],bio:g('bio'),snack:'',avatar:'',instagram:'',tiktok:'',strava:'',added:new Date().toISOString()};\n      pets.push(p);save().then(render).catch(function(){});\n    },true);\n  }\n  function init(){\n    ms=window.$memberstackDom;grid=document.querySelector('.tll-mypets-grid');title=document.querySelector('.tll-mypets-grid-title');\n    if(!ms||!grid)return;\n    panel=document.createElement('div');panel.className='tpe-panel';panel.hidden=true;panel.id='tpe-panel';grid.parentNode.insertBefore(panel,grid.nextSibling);\n    ms.getCurrentMember().then(function(r){\n      member=r&&r.data;if(!member)return null;\n      return ms.getMemberJSON().then(function(j){\n        json=(j&&j.data)||{};pets=Array.isArray(json.pets)?json.pets:[];\n        var cf=member.customFields||{},slug=cf['custom-slug']||slugify((cf['first-name']||'')+' '+(cf['last-name']||''));\n        var seed=!json.petsSeeded&&slug===FOUNDER_SLUG&&!pets.some(function(p){return p.cmsSlug==='magnus-waffles';});\n        if(seed){pets.unshift(MAGNUS);json.petsSeeded=true;}\n        var mg=pets.filter(function(p){return p.cmsSlug==='magnus-waffles'&&!p.cmsSync2;})[0];\n        if(!mg)return seed?save():null;\n        /* One-time sync (21 Sep 2026): Nancy confirmed Magnus's countries and weight; pull them from the CMS item. */\n        return fetch('/pets/magnus-waffles',{cache:'no-cache'}).then(function(r){return r.text();}).then(function(h){var m=h.match(/window\\.TLL_PET=\\{countries:\"([^\"]*)\",weight:\"([^\"]*)\"\\}/);if(m){var cl=m[1].split(',').map(function(x){return x.trim();}).filter(Boolean);if(cl.length)mg.countries=cl;var w=parseFloat(m[2]);if(w)mg.weightKg=w;mg.cmsSync2=true;return save();}return seed?save():null;}).catch(function(){return seed?save():null;});\n      });\n    }).then(function(){if(member){render();hookAddForm();grid.addEventListener('click',function(e){var b=e.target.closest('.tpe-edit');if(b)openEdit(+b.getAttribute('data-i'));});}}).catch(function(e){if(window.console)console.warn('[tll-pet-editor]',e);});\n  }\n  if(window.$memberstackDom)init();else{var n=0,t=setInterval(function(){if(window.$memberstackDom||++n>40){clearInterval(t);init();}},250);}\n})();\n</script>",
