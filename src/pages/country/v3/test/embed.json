"<style>.tllcx-hero{background:#0A0B14;position:relative;overflow:hidden;padding:88px 24px 72px;color:#F7F1E8}.tllcx-hero:before{content:'';position:absolute;top:-120px;left:-80px;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,#00C9C8,transparent 70%);opacity:.14}.tllcx-hero [class*=eyebrow]{color:#00C9C8 !important}.tllcx-wrap{max-width:980px;margin:0 auto;position:relative}.tllcx-flag{font-size:56px;line-height:1;margin-bottom:18px}.tllcx-hero h1{color:#F7F1E8;margin:12px 0 14px}.tllcx-verdict{font-size:19px;line-height:1.55;color:#cfcbc4;max-width:640px;margin:0}.tllcx-verdict.w-dyn-bind-empty{display:none}.tllcx-body{background:#FDF9F3;padding:64px 24px 80px}.tllcx-eb{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:3px;font-weight:600;color:#067A79;text-transform:uppercase;margin:0 0 14px}.tllcx-facts{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:40px}.tllcx-fact{background:#fff;border:1px solid #E0DACE;border-radius:10px;padding:16px 18px}.tllcx-label{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:2px;color:#6B6660;text-transform:uppercase;margin-bottom:6px}.tllcx-value{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:22px;color:#0A0B14;line-height:1.2}.tllcx-fact:has(.w-dyn-bind-empty){display:none}.tllcx-word{background:#0A0B14;color:#F7F1E8;border-radius:14px;padding:28px 30px;margin-bottom:40px}.tllcx-word .tllcx-eb{color:#00C9C8}.tllcx-big{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:44px;color:#F7F1E8;line-height:1}.tllcx-word p{color:#cfcbc4;margin:10px 0 0;font-size:16px;line-height:1.6}.tllcx-word .tllcx-src{color:#9a9bb0;font-size:12px}.tllcx-word .w-dyn-bind-empty{display:none}.tllcx-cta{background:#fff;border:1px dashed #067A79;border-radius:14px;padding:28px 30px;margin-bottom:28px}.tllcx-cta h2{font-size:30px;margin:0 0 8px;color:#0A0B14}.tllcx-cta p{color:#3a3a3a;margin:0 0 18px}.tllcx-cta .tll-btn{margin-right:10px;margin-bottom:8px}.tllcx-src{font-size:13px;color:#6B6660;line-height:1.6}@media(max-width:767px){.tllcx-hero{padding:56px 20px 48px}.tllcx-body{padding:44px 20px 56px}.tllcx-big{font-size:36px}}</style><script>document.addEventListener('DOMContentLoaded',function(){[].forEach.call(document.querySelectorAll('.tllcx-value'),function(e){var t=e.textContent.trim();if(/^\\d{4,}$/.test(t))e.textContent=Number(t).toLocaleString('en-US');});});</script>"
